<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
           targetNamespace="adobe:ns:meta/"
           elementFormDefault="qualified">
    <xs:annotation><xs:documentation source="https://xmlgraphics.apache.org/fop/2.12/metadata.html">XMP metadata wrapper used by FOP. Imports the supported RDF and Dublin Core vocabulary; additional namespaces can be used within rdf:Description.</xs:documentation></xs:annotation>
    <xs:import namespace="http://www.w3.org/1999/02/22-rdf-syntax-ns#" schemaLocation="rdf.xsd"/>
    <xs:import namespace="http://purl.org/dc/elements/1.1/" schemaLocation="dc.xsd"/>
    <xs:element name="xmpmeta">
        <xs:annotation><xs:documentation>Wraps one rdf:RDF packet. For document metadata in FOP, put this inside fo:declarations after the layout-master-set and before the page sequences.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence><xs:element ref="rdf:RDF"/></xs:sequence>
            <xs:attribute name="xmptk" type="xs:string" form="qualified">
                <xs:annotation><xs:documentation>Optional name or identifier of the XMP toolkit that wrote the packet.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:anyAttribute namespace="##other" processContents="lax"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
