<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:pdf="http://xmlgraphics.apache.org/fop/extensions/pdf"
           xmlns:x="adobe:ns:meta/"
           targetNamespace="http://xmlgraphics.apache.org/fop/extensions/pdf"
           elementFormDefault="qualified">
    <xs:annotation><xs:documentation source="https://xmlgraphics.apache.org/fop/2.12/metadata.html">Apache FOP PDF extension namespace. Separate from Adobe's XMP PDF namespace (http://ns.adobe.com/pdf/1.3/). These objects affect PDF output, not the FO layout.</xs:documentation></xs:annotation>
    <xs:import namespace="adobe:ns:meta/" schemaLocation="xmpmeta.xsd"/>
    <xs:element name="info">
        <xs:annotation><xs:documentation>Custom entries for the PDF Info dictionary. Put under fo:declarations. Example: &lt;pdf:name key="Project"&gt;Schema audit&lt;/pdf:name&gt;. Use XMP or FOUserAgent for standard fields such as Title.</xs:documentation></xs:annotation>
        <xs:complexType><xs:sequence><xs:element ref="pdf:name" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="catalog" type="pdf:Entries">
        <xs:annotation><xs:documentation>PDF catalog entries, under fo:declarations. For example, add a dictionary with key="ViewerPreferences" and a name with key="Duplex" and value DuplexFlipShortEdge.</xs:documentation></xs:annotation>
    </xs:element>
    <xs:element name="layer" type="pdf:IdentifiedEntries">
        <xs:annotation><xs:documentation>Define a PDF optional-content group under fo:declarations. Use pdf:string with key="Name" for the display name; refer to the ID from fox:layer.</xs:documentation></xs:annotation>
    </xs:element>
    <xs:element name="pagepiece" type="pdf:Entries">
        <xs:annotation><xs:documentation>Custom PDF PagePiece entries on an fo:simple-page-master. Intended for page-level indexing or private application data.</xs:documentation></xs:annotation>
    </xs:element>
    <xs:element name="page">
        <xs:annotation><xs:documentation>Attach PDF dictionary entries or an XMP packet to pages generated from an fo:simple-page-master.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded"><xs:group ref="pdf:Entry"/><xs:element ref="x:xmpmeta"/></xs:choice>
            <xs:attribute name="page-numbers" type="xs:token"><xs:annotation><xs:documentation>Page selection, e.g. "*" for all, "2-4" for a range, or a comma-separated list.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="embedded-file">
        <xs:annotation><xs:documentation>Attach a file to the output PDF. Put under fo:declarations. Attachments are subject to PDF profile restrictions.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="src" type="xs:string" use="required"><xs:annotation><xs:documentation>URI of the file to attach, e.g. url('data.csv').</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="filename" type="xs:string"><xs:annotation><xs:documentation>Filename displayed in the PDF attachments panel. FOP derives a name from src if omitted.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="description" type="xs:string"><xs:annotation><xs:documentation>Optional description of the attachment, e.g. "Source data in CSV format".</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:group name="Entry">
        <xs:annotation><xs:documentation>Values supported in a PDF dictionary or array. Include key on dictionary entries and omit it on array items.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:element ref="pdf:array"/><xs:element ref="pdf:dictionary"/><xs:element ref="pdf:boolean"/>
            <xs:element ref="pdf:name"/><xs:element ref="pdf:number"/><xs:element ref="pdf:string"/><xs:element ref="pdf:reference"/>
        </xs:choice>
    </xs:group>
    <xs:complexType name="Entries">
        <xs:annotation><xs:documentation>Dictionary or array entries, including nested collections. FOP checks where keys are required or forbidden.</xs:documentation></xs:annotation>
        <xs:group ref="pdf:Entry" minOccurs="0" maxOccurs="unbounded"/>
    </xs:complexType>
    <xs:complexType name="IdentifiedEntries">
        <xs:annotation><xs:documentation>Dictionary declaration that can be referred to by ID.</xs:documentation></xs:annotation>
        <xs:complexContent><xs:extension base="pdf:Entries">
            <xs:attribute name="id" type="xs:ID" use="required"><xs:annotation><xs:documentation>Unique name referred to by refid or fox:layer.</xs:documentation></xs:annotation></xs:attribute>
        </xs:extension></xs:complexContent>
    </xs:complexType>
    <xs:attributeGroup name="Key">
        <xs:annotation><xs:documentation>A key for entries inside PDF dictionaries.</xs:documentation></xs:annotation>
        <xs:attribute name="key" type="xs:string"><xs:annotation><xs:documentation>PDF dictionary entry name without its leading slash, e.g. Duplex. Omit on an array item.</xs:documentation></xs:annotation></xs:attribute>
    </xs:attributeGroup>
    <xs:complexType name="Collection">
        <xs:annotation><xs:documentation>Nested PDF dictionary or array, with a key only if its parent is a dictionary.</xs:documentation></xs:annotation>
        <xs:complexContent><xs:extension base="pdf:Entries"><xs:attributeGroup ref="pdf:Key"/></xs:extension></xs:complexContent>
    </xs:complexType>
    <xs:complexType name="TextEntry">
        <xs:annotation><xs:documentation>Text or a PDF name with an optional dictionary key.</xs:documentation></xs:annotation>
        <xs:simpleContent><xs:extension base="xs:string"><xs:attributeGroup ref="pdf:Key"/></xs:extension></xs:simpleContent>
    </xs:complexType>
    <xs:element name="dictionary" type="pdf:Collection"><xs:annotation><xs:documentation>Nested key/value mapping, e.g. ViewerPreferences.</xs:documentation></xs:annotation></xs:element>
    <xs:element name="array" type="pdf:Collection"><xs:annotation><xs:documentation>Ordered values. Omit the key attribute on each child.</xs:documentation></xs:annotation></xs:element>
    <xs:element name="name" type="pdf:TextEntry"><xs:annotation><xs:documentation>PDF name without the leading slash, or a text value when used inside pdf:info.</xs:documentation></xs:annotation></xs:element>
    <xs:element name="string" type="pdf:TextEntry"><xs:annotation><xs:documentation>PDF text string, e.g. the display name of a layer.</xs:documentation></xs:annotation></xs:element>
    <xs:element name="boolean">
        <xs:annotation><xs:documentation>PDF boolean, written true or false.</xs:documentation></xs:annotation>
        <xs:complexType><xs:simpleContent><xs:extension base="pdf:BooleanText"><xs:attributeGroup ref="pdf:Key"/></xs:extension></xs:simpleContent></xs:complexType>
    </xs:element>
    <xs:simpleType name="BooleanText">
        <xs:annotation><xs:documentation>Literal true and false accepted for PDF boolean values.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:token"><xs:enumeration value="true"/><xs:enumeration value="false"/></xs:restriction>
    </xs:simpleType>
    <xs:element name="number">
        <xs:annotation><xs:documentation>PDF numeric value, e.g. 12 or 0.5.</xs:documentation></xs:annotation>
        <xs:complexType><xs:simpleContent><xs:extension base="xs:decimal"><xs:attributeGroup ref="pdf:Key"/></xs:extension></xs:simpleContent></xs:complexType>
    </xs:element>
    <xs:element name="reference">
        <xs:annotation><xs:documentation>Reference to an identified PDF extension object, e.g. a pdf:layer.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="pdf:Key"/>
            <xs:attribute name="refid" type="xs:NCName" use="required"><xs:annotation><xs:documentation>ID of the PDF extension object being referenced.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
