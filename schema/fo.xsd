        <xs:attribute name="space-end">
            <xs:annotation>
                <xs:documentation>Space after an inline area in the inline progression direction. For example, space-end="14pt" on fo:inline moves subsequent text by 14pt in FOP PDF output.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-end.minimum">
            <xs:annotation><xs:documentation>Smallest allowed space end, e.g. "1pt".</xs:documentation></xs:annotation>
