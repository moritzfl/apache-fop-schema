            <xs:attribute name="ref-id" type="xs:NCName" use="required"><xs:annotation><xs:documentation>ID of the target object. Use the page sequence ID to cite its last page.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="retrieve-table-marker">
        <xs:annotation>
            <xs:documentation compat:feature="fo:retrieve-table-marker"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="source area-tree-test">
                Inserts a matching fo:marker in a table header or footer, e.g. a running label carried across page breaks.

                FOP 2.12: Partial. Taller retrieved content does not increase the row height. Reserve room in the cell.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="retrieve-class-name" type="xs:NCName" use="required"><xs:annotation><xs:documentation>Marker class to retrieve; must match marker-class-name.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="retrieve-position-within-table"><xs:annotation><xs:documentation>Which eligible marker to retrieve in the table fragment.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="first-starting"/><xs:enumeration value="first-including-carryover"/><xs:enumeration value="last-starting"/><xs:enumeration value="last-ending"/></xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="retrieve-boundary-within-table"><xs:annotation><xs:documentation>Limit the search to the table fragment, page or whole table.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="table-fragment"/><xs:enumeration value="page"/><xs:enumeration value="table"/></xs:restriction></xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="change-bar-begin">
        <xs:annotation><xs:documentation>Begin marking revised content. Pair with fo:change-bar-end using the same class, e.g. change-bar-class="revision".</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="change-bar-class" type="xs:string" use="required"><xs:annotation><xs:documentation>Name that pairs the beginning and end of this change bar.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-bar-color" type="xs:string"><xs:annotation><xs:documentation>Color of the change bar, e.g. blue.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-bar-offset" type="xs:string"><xs:annotation><xs:documentation>Gap between the bar and the edge of the reference area, e.g. 4pt.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-bar-placement" type="xs:string"><xs:annotation><xs:documentation>Side of the change bar, e.g. start, end, inside, or outside.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-bar-style" type="xs:string"><xs:annotation><xs:documentation>Border style used for the bar, e.g. solid or dashed.</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="change-bar-width" type="xs:string"><xs:annotation><xs:documentation>Thickness of the bar, e.g. 2pt.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="change-bar-end">
        <xs:annotation><xs:documentation>End a change bar begun earlier in this page sequence.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="change-bar-class" type="xs:NCName" use="required"><xs:annotation><xs:documentation>Class matching the preceding fo:change-bar-begin.</xs:documentation></xs:annotation></xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
