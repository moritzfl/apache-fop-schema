        </xs:attribute>
        <xs:attribute name="letter-spacing.precedence">
            <xs:annotation><xs:documentation>Priority of letter spacing when adjacent spaces compete. A higher integer takes precedence; force means the space is always included.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="letter-spacing.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard letter spacing at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="retain"/>
                    <xs:enumeration value="discard"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="word-spacing">
            <xs:annotation><xs:documentation>Space adjustment between words, e.g. "1pt", or normal.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="word-spacing.minimum">
            <xs:annotation><xs:documentation>Smallest allowed word spacing, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="word-spacing.optimum">
            <xs:annotation><xs:documentation>Preferred word spacing, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="word-spacing.maximum">
            <xs:annotation><xs:documentation>Largest allowed word spacing, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="word-spacing.precedence">
            <xs:annotation><xs:documentation>Priority of word spacing when adjacent spaces compete. A higher integer takes precedence; force means the space is always included.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="word-spacing.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard word spacing at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="retain"/>
                    <xs:enumeration value="discard"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="treat-as-word-space">
            <xs:annotation>
                <xs:documentation compat:feature="treat-as-word-space"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Decide whether a character participates in word spacing.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="true"/>
                    <xs:enumeration value="false"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="text-decoration" type="xs:NMTOKENS">
            <xs:annotation><xs:documentation>Decorate glyphs, e.g. underline or line-through. Decorated link text still needs fo:basic-link for interactivity.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="score-spaces">
            <xs:annotation>
                <xs:documentation compat:feature="score-spaces"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Whether spaces participate in text decoration such as underlining.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="true"/>
                    <xs:enumeration value="false"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="text-shadow">
            <xs:annotation>
                <xs:documentation compat:feature="text-shadow"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source runtime-probe">
                    Shadow offsets, optional blur and color for text in the standard.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="text-transform">
            <xs:annotation><xs:documentation>Alter displayed case, e.g. uppercase, lowercase or capitalize.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="capitalize"/>
                    <xs:enumeration value="uppercase"/>
                    <xs:enumeration value="lowercase"/>
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="suppress-at-line-break">
            <xs:annotation>
                <xs:documentation compat:feature="suppress-at-line-break"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Suppress a character at a line break, such as a trailing space.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="suppress"/>
                    <xs:enumeration value="retain"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="text-altitude">
            <xs:annotation>
                <xs:documentation compat:feature="text-altitude"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Distance above the baseline used when calculating line height.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="text-depth">
            <xs:annotation>
                <xs:documentation compat:feature="text-depth"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Distance below the baseline used when calculating line height.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="glyph-orientation-horizontal">
            <xs:annotation>
                <xs:documentation compat:feature="glyph-orientation-horizontal"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source runtime-probe">
                    Glyph rotation in a horizontal writing mode.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="0"/>
                    <xs:enumeration value="90"/>
                    <xs:enumeration value="180"/>
                    <xs:enumeration value="270"/>
                    <xs:enumeration value="-90"/>
                    <xs:enumeration value="-180"/>
                    <xs:enumeration value="-270"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="glyph-orientation-vertical">
            <xs:annotation>
                <xs:documentation compat:feature="glyph-orientation-vertical"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source runtime-probe">
                    Glyph rotation in a vertical writing mode.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="0"/>
                    <xs:enumeration value="90"/>
                    <xs:enumeration value="180"/>
                    <xs:enumeration value="270"/>
                    <xs:enumeration value="-90"/>
                    <xs:enumeration value="-180"/>
                    <xs:enumeration value="-270"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attributeGroup ref="fo:font-properties"/>
        <xs:attributeGroup ref="fo:line-height-properties"/>
    </xs:attributeGroup>
    <xs:attributeGroup name="keeps-and-breaks-properties-atomic">
        <xs:annotation><xs:documentation>Forced breaks and keeps with adjacent areas. Prefer specific components such as keep-with-next.within-page="always".</xs:documentation></xs:annotation>
        <xs:attribute name="break-after">
            <xs:annotation><xs:documentation>Insert a forced break after this area, e.g. page, even-page, odd-page or column.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="column"/>
                    <xs:enumeration value="page"/>
                    <xs:enumeration value="even-page"/>
                    <xs:enumeration value="odd-page"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="break-before">
            <xs:annotation><xs:documentation>Insert a forced break before this area, e.g. break-before="page" to start a new PDF page.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="column"/>
                    <xs:enumeration value="page"/>
                    <xs:enumeration value="even-page"/>
                    <xs:enumeration value="odd-page"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="keep-with-next">
            <xs:annotation>
                <xs:documentation compat:feature="keep-with-next"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Keep this object with the following object. Prefer keep-with-next.within-page="always" for a heading and its first paragraph.

                    FOP 2.12: Partial. Block-level keeps work, inline keeps and integer strengths have limits.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-next.within-line">
            <xs:annotation><xs:documentation>Keep this object with the next one within the same line. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-next.within-column">
            <xs:annotation><xs:documentation>Keep this object with the next one within the same column. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-next.within-page">
            <xs:annotation><xs:documentation>Keep this object with the next one within the same page. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-previous">
            <xs:annotation>
                <xs:documentation compat:feature="keep-with-previous"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Keep this object with the preceding object. Prefer keep-with-previous.within-page="always" for a caption.

                    FOP 2.12: Partial. Block-level keeps work, inline keeps and integer strengths have limits.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-previous.within-line">
            <xs:annotation><xs:documentation>Keep this object with the previous one within the same line. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-previous.within-column">
            <xs:annotation><xs:documentation>Keep this object with the previous one within the same column. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-with-previous.within-page">
            <xs:annotation><xs:documentation>Keep this object with the previous one within the same page. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="page-break-after">
            <xs:annotation><xs:documentation>Page-break shorthand applied after an object. Prefer break-after="page" for an explicit page break.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="always"/>
                    <xs:enumeration value="avoid"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="page-break-before">
            <xs:annotation><xs:documentation>Page-break shorthand applied before an object. Prefer break-before="page" for an explicit page break.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="always"/>
                    <xs:enumeration value="avoid"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="keeps-and-breaks-properties-inline">
        <xs:annotation><xs:documentation>Keeps within the current line, column or page, including keep-together.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="fo:keeps-and-breaks-properties-atomic"/>
        <xs:attribute name="keep-together">
            <xs:annotation>
                <xs:documentation compat:feature="keep-together integer strength"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source runtime-probe">
                    Keep a single object from splitting. Prefer a specific component; the shorthand includes within-line and can prevent normal line wrapping.

                    FOP 2.12: Partial. Positive integers share the same break penalty. Use always on the page or column component for an unconditional keep.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-together.within-line">
            <xs:annotation><xs:documentation>Keep this object together within the same line. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-together.within-column">
            <xs:annotation><xs:documentation>Keep this object together within the same column. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="keep-together.within-page">
            <xs:annotation><xs:documentation>Keep this object together within the same page. Use always for an unconditional keep or auto for no keep.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="page-break-inside">
            <xs:annotation><xs:documentation>Page-break shorthand for splitting an object. Prefer keep-together.within-page="always" for an explicit keep.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="avoid"/>
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="keeps-and-breaks-properties-block">
        <xs:annotation><xs:documentation>Forced breaks, keeps and the minimum lines allowed before or after a break.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="fo:keeps-and-breaks-properties-inline"/>
        <xs:attribute name="orphans">
            <xs:annotation><xs:documentation>Minimum lines kept at the bottom of a page or column before a break, e.g. 2.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="widows">
            <xs:annotation><xs:documentation>Minimum lines carried to the top of the next page or column after a break, e.g. 2.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="leader-properties">
        <xs:annotation><xs:documentation>Control the length and appearance of leaders, such as the dots in a table of contents.</xs:documentation></xs:annotation>
        <xs:attribute name="leader-alignment">
            <xs:annotation>
                <xs:documentation compat:feature="leader-alignment"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Aligns repeated leader patterns to the start edge of the page or reference area.

                    FOP 2.12: Unsupported. Dots start at the leader's own position instead of lining up with those on other lines.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="reference-area"/>
                    <xs:enumeration value="page"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="leader-pattern">
            <xs:annotation><xs:documentation>Pattern used to fill a gap: space, dots, rule, or use-content for repeated custom content.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="space"/>
                    <xs:enumeration value="rule"/>
                    <xs:enumeration value="dots"/>
                    <xs:enumeration value="use-content"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="leader-pattern-width" type="fo:leader_pattern_width_Type">
            <xs:annotation><xs:documentation>Repetition interval, e.g. "4pt" for dots or use-font-metrics for natural glyph spacing.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="leader-length" type="xs:string">
            <xs:annotation><xs:documentation>Length along the inline direction, e.g. leader-length="40pt". Use the .minimum, .optimum and .maximum attributes for a flexible range.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="leader-length.minimum" type="fo:length_Type">
            <xs:annotation><xs:documentation>Smallest allowed leader length, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="leader-length.optimum" type="fo:length_Type">
            <xs:annotation><xs:documentation>Preferred leader length, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="leader-length.maximum" type="fo:length_Type">
            <xs:annotation><xs:documentation>Largest allowed leader length, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rule-style">
            <xs:annotation><xs:documentation>Style for leader-pattern="rule", e.g. solid, dashed, or dotted. For FOP square dots use fox:rule-style="square".</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="dotted"/>
                    <xs:enumeration value="dashed"/>
                    <xs:enumeration value="solid"/>
                    <xs:enumeration value="double"/>
                    <xs:enumeration value="groove"/>
                    <xs:enumeration value="ridge"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="rule-thickness" type="fo:length_Type">
            <xs:annotation><xs:documentation>Thickness of a rule leader, e.g. "0.5pt".</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="table-properties">
        <xs:annotation><xs:documentation>Table layout, border separation and repeating header/footer behavior. Use fixed layout in FOP.</xs:documentation></xs:annotation>
        <xs:attribute name="border-collapse">
            <xs:annotation>
                <xs:documentation compat:feature="border-collapse=&quot;collapse-with-precedence&quot;"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="pdf-test source">
                    Choose whether table borders are separate or shared. Use separate for a gap between cells or rounded outer corners.

                    FOP 2.12: Unsupported. FOP warns and uses collapse.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="collapse"/>
                    <xs:enumeration value="collapse-with-precedence"/>
                    <xs:enumeration value="separate"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="border-spacing">
            <xs:annotation><xs:documentation>CSS-style shorthand for spacing between separate table borders. Prefer border-separation for explicit FO control.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-separation">
            <xs:annotation><xs:documentation>Distance between adjacent cell borders when border-collapse="separate", e.g. "2pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-separation.inline-progression-direction">
            <xs:annotation><xs:documentation>Cell border gap in the inline direction (horizontal in normal Western text).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-separation.block-progression-direction">
            <xs:annotation><xs:documentation>Cell border gap in the block direction (vertical in normal Western text).</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="caption-side">
            <xs:annotation>
                <xs:documentation compat:feature="caption-side"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Position of a caption relative to its table.

                    FOP 2.12: Unsupported. Changing caption-side does not move the caption. For a caption below the table, use a separate block.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="before"/>
                    <xs:enumeration value="after"/>
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="end"/>
                    <xs:enumeration value="top"/>
                    <xs:enumeration value="bottom"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="empty-cells">
            <xs:annotation>
                <xs:documentation>Controls borders and background for empty cells in a separated-border table. For example, empty-cells="hide" on an empty fo:table-cell suppresses its border when the table uses border-collapse="separate".</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="show"/>
                    <xs:enumeration value="hide"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="table-layout">
            <xs:annotation>
                <xs:documentation compat:feature="table-layout=&quot;auto&quot;"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="pdf-test source">
                    Column width layout algorithm. For FOP use fixed with widths on fo:table-column, e.g. 60pt or proportional-column-width(1).

                    FOP 2.12: Unsupported. Renders with a fallback, without automatic column sizing.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="fixed"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="table-omit-header-at-break">
            <xs:annotation><xs:documentation>Set true to omit repeated table headers on continuation fragments after a page or column break.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="true"/>
                    <xs:enumeration value="false"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="table-omit-footer-at-break">
            <xs:annotation><xs:documentation>Set true to omit repeated table footers at page or column breaks.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="true"/>
                    <xs:enumeration value="false"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="list-properties">
        <xs:annotation><xs:documentation>Determine the nominal distance between the label and body and the gap before the body.</xs:documentation></xs:annotation>
        <xs:attribute name="provisional-distance-between-starts">
            <xs:annotation><xs:documentation>Nominal distance from the label start to the body start. Use body-start() on the list item body to use this value.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="provisional-label-separation">
            <xs:annotation><xs:documentation>Nominal gap from the label’s end to the body. Use label-end() on the list item label to apply it.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="float-properties">
        <xs:annotation><xs:documentation>Float placement and handling of surrounding content. Check the FOP compatibility notes for side-float restrictions.</xs:documentation></xs:annotation>
        <xs:attribute name="float">
            <xs:annotation>
                <xs:documentation compat:feature="float=&quot;before&quot;"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test upstream-docs" source="https://xmlgraphics.apache.org/fop/fo.html#floats">
                    Float to the start or end side and allow surrounding content to flow past where supported.

                    FOP 2.12: Unsupported. Use a side float; the before value does not place content at the start of a page.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="before"/>
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="end"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="clear">
            <xs:annotation>
                <xs:documentation compat:feature="clear"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Move content past previous floats on the selected sides.

                    FOP 2.12: Unsupported. Do not rely on it to clear side floats.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="end"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="both"/>
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="intrusion-displace">
            <xs:annotation>
                <xs:documentation compat:feature="intrusion-displace"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    How surrounding content is displaced by an intrusion such as a side float.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="line"/>
                    <xs:enumeration value="indent"/>
                    <xs:enumeration value="block"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="visibility-properties">
        <xs:annotation><xs:documentation>Properties governing area visibility and stacking in the XSL-FO model.</xs:documentation></xs:annotation>
        <xs:attribute name="visibility">
            <xs:annotation>
                <xs:documentation>Whether an area paints without changing its layout, e.g. visible or hidden. On fo:block, visibility="hidden" hides the text but preserves its space before the following block.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="visible"/>
                    <xs:enumeration value="hidden"/>
                    <xs:enumeration value="collapse"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="z-index">
            <xs:annotation>
                <xs:documentation compat:feature="z-index"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Paint stacking order for overlapping areas.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="inheritable-properties">
        <xs:annotation><xs:documentation>Shared vocabulary for text, alignment, sizing, spacing and layout. Not every property applies to every object using this group.</xs:documentation></xs:annotation>
        <xs:attribute name="color">
            <xs:annotation>
                <xs:documentation>
                    Specifies the color of text. Use a named color, hexadecimal color, FO color function, or "inherit".
                    Examples: "#ff0000", "rgb(255,0,0)", "red", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:color_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="relative-align">
            <xs:annotation>
                <xs:documentation compat:feature="relative-align"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Align with the preceding object’s baseline or before edge in the standard.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="before"/>
                    <xs:enumeration value="baseline"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="span">
            <xs:annotation><xs:documentation>Use all on a block to span all columns of the body region, or none to use the current column.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="all"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attributeGroup ref="fo:accessibility-properties"/>
        <xs:attributeGroup ref="fo:absolute-or-relative-position-properties"/>
        <xs:attributeGroup ref="fo:border-padding-background-properties"/>
        <xs:attributeGroup ref="fo:border-precedence-properties"/>
        <xs:attributeGroup ref="fo:aural-properties"/>
        <xs:attributeGroup ref="fo:box-size-properties"/>
        <xs:attributeGroup ref="fo:margin-properties-inline"/>
        <xs:attributeGroup ref="fo:area-properties"/>
        <xs:attributeGroup ref="fo:area-alignment-properties-inline"/>
        <xs:attributeGroup ref="fo:character-properties"/>
        <xs:attributeGroup ref="fo:table-properties"/>
        <xs:attributeGroup ref="fo:list-properties"/>
        <xs:attributeGroup ref="fo:float-properties"/>
        <xs:attributeGroup ref="fo:line-related-properties"/>
        <xs:attributeGroup ref="fo:leader-properties"/>
        <xs:attributeGroup ref="fo:keeps-and-breaks-properties-block"/>
        <xs:attributeGroup ref="fo:hyphenation-properties-block"/>
        <xs:attributeGroup ref="fo:visibility-properties"/>
        <xs:attribute ref="fox:layer"/>
    </xs:attributeGroup>
    <xs:attributeGroup name="block-properties">
        <xs:annotation><xs:documentation>Common formatting properties and a unique link target ID for block objects.</xs:documentation></xs:annotation>
        <xs:attribute name="id" type="xs:ID">
            <xs:annotation>
                <xs:documentation compat:feature="id as a layout target"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Unique FO identifier, e.g. "results". Reference it from internal-destination or a page-number citation.

                    FOP 2.12: Partial. An internal link does not resolve to an ID on fo:table-row. Put the ID on a block inside the row instead.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="fo:inheritable-properties"/>
    </xs:attributeGroup>
    <xs:attributeGroup name="inline-properties">
        <xs:annotation><xs:documentation>Common formatting properties and a unique link target ID for inline objects.</xs:documentation></xs:annotation>
        <xs:attribute name="id" type="xs:ID">
            <xs:annotation><xs:documentation>Unique FO identifier, e.g. "results". Reference it from internal-destination or a page-number citation.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="fo:inheritable-properties"/>
    </xs:attributeGroup>
    <xs:attributeGroup name="empty-inline-properties">
        <xs:annotation><xs:documentation>Applicable text and area properties on inline objects with no child content, such as page numbers.</xs:documentation></xs:annotation>
        <xs:attribute name="id" type="xs:ID">
            <xs:annotation><xs:documentation>Unique FO identifier, e.g. "results". Reference it from internal-destination or a page-number citation.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="color">
            <xs:annotation>
                <xs:documentation>
                    Specifies the color of text. Use a named color, hexadecimal color, FO color function, or "inherit".
                    Examples: "#ff0000", "rgb(255,0,0)", "red", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:color_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attributeGroup ref="fo:accessibility-properties"/>
        <xs:attributeGroup ref="fo:aural-properties"/>
        <xs:attributeGroup ref="fo:relative-position-properties"/>
        <xs:attributeGroup ref="fo:area-alignment-properties-inline"/>
        <xs:attributeGroup ref="fo:character-properties"/>
        <xs:attributeGroup ref="fo:border-padding-background-properties"/>
        <xs:attributeGroup ref="fo:hyphenation-properties-inline"/>
        <xs:attributeGroup ref="fo:visibility-properties"/>
    </xs:attributeGroup>
    <xs:attributeGroup name="graphic-properties">
        <xs:annotation>
            <xs:documentation>
                Defines attributes for graphic elements (external-graphic and instream-foreign-object). These properties
                control how graphics are sized, scaled, aligned, and displayed within the document.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:ID">
            <xs:annotation>
                <xs:documentation>
                    Specifies a unique identifier for the graphic element.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="content-type">
            <xs:annotation>
                <xs:documentation compat:feature="content-type"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Specifies the MIME type of the graphic content (e.g., "image/jpeg", "image/svg+xml").

                    FOP 2.12: Unsupported. FOP detects supported graphic types from the source.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="fo:accessibility-properties"/>
        <xs:attribute ref="fox:alt-text"/>
        <xs:attributeGroup ref="fo:relative-position-properties"/>
        <xs:attributeGroup ref="fo:aural-properties"/>
        <xs:attributeGroup ref="fo:border-padding-background-properties"/>
        <xs:attributeGroup ref="fo:margin-properties-inline"/>
        <xs:attributeGroup ref="fo:area-alignment-properties-inline"/>
        <xs:attributeGroup ref="fo:box-size-properties"/>
        <xs:attributeGroup ref="fo:font-properties"/>
        <xs:attributeGroup ref="fo:line-height-properties"/>
        <xs:attributeGroup ref="fo:keeps-and-breaks-properties-atomic"/>
        <xs:attribute name="content-height">
            <xs:annotation>
                <xs:documentation>
                    Specifies the height of the graphic content. Can be a length, a percentage, or "auto" (default).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="content-width">
            <xs:annotation>
                <xs:documentation>
                    Specifies the width of the graphic content. Can be a length, a percentage, or "auto" (default).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="display-align">
            <xs:annotation>
                <xs:documentation>
                    Specifies the alignment of content within the display area when the content area is larger than the content.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="before"/>
                    <xs:enumeration value="center"/>
                    <xs:enumeration value="after"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="overflow">
            <xs:annotation>
                <xs:documentation>
                    Specifies what happens when content overflows the allocated area.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="visible"/>
                    <xs:enumeration value="hidden"/>
                    <xs:enumeration value="scroll"/>
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="error-if-overflow"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="scaling">
            <xs:annotation>
                <xs:documentation>
                    Specifies how the graphic should be scaled to fit the specified dimensions. "uniform" preserves the aspect ratio, while "non-uniform" may distort the image.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="uniform"/>
                    <xs:enumeration value="non-uniform"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="scaling-method">
            <xs:annotation>
                <xs:documentation compat:feature="scaling-method"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Specifies the method used for scaling the graphic.

                    FOP 2.12: Unsupported. Scaling (uniform or non-uniform) is a separate property.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="integer-pixels"/>
                    <xs:enumeration value="resample-any-method"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="text-align">
            <xs:annotation>
                <xs:documentation>
                    Specifies the alignment of text within the graphic area. Prefer start, end, center or justify.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="center"/>
                    <xs:enumeration value="end"/>
                    <xs:enumeration value="justify"/>
                    <xs:enumeration value="inside"/>
                    <xs:enumeration value="outside"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:element name="root">
        <xs:annotation>
            <xs:documentation>
                Starts an FO document. Define page masters first, then optional declarations and bookmarks, then at least one fo:page-sequence or fox:external-document.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:layout-master-set"/>
                <xs:element ref="fo:declarations" minOccurs="0"/>
                <xs:element ref="fo:bookmark-tree" minOccurs="0"/>
                <xs:element ref="fox:destination" minOccurs="0" maxOccurs="unbounded"/>
                <xs:choice>
                    <xs:element ref="fo:page-sequence"/>
                    <xs:element ref="fox:external-document"/>
                </xs:choice>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element ref="fo:page-sequence"/>
                    <xs:element ref="fox:external-document"/>
                    <xs:element ref="fox:destination"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="media-usage">
                <xs:annotation>
                    <xs:documentation compat:feature="media-usage"
                                      compat:status="unsupported" compat:fop="2.12"
                                      compat:evidence="source area-tree-test">
                        Specifies how the formatted result is intended to be used. Values include: auto, paginate, bounded-in-one-dimension, and unbounded.

                        FOP 2.12: Unsupported.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="auto"/>
                        <xs:enumeration value="paginate"/>
                        <xs:enumeration value="bounded-in-one-dimension"/>
                        <xs:enumeration value="unbounded"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attributeGroup ref="fo:inheritable-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="declarations">
        <xs:annotation>
            <xs:documentation>
                Holds document metadata, ICC profiles and PDF-level settings. Place it after layout-master-set and before any bookmarks or page sequences. Put document XMP in a single packet; FOP uses the first one.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element ref="fo:color-profile"/>
                    <xs:element ref="x:xmpmeta"/>
                    <xs:element ref="rdf:RDF"/>
                    <xs:element ref="pdf:info"/>
                    <xs:element ref="pdf:catalog"/>
                    <xs:element ref="pdf:layer"/>
                    <xs:element ref="pdf:embedded-file"/>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="color-profile">
        <xs:annotation>
            <xs:documentation>
                Names an ICC profile for use in rgb-icc() or other profile-aware color expressions. Set color-profile-name and point src to the profile file.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="src" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the URI of the color profile resource (typically an ICC profile).
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="color-profile-name" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Name used to resolve this profile in a color expression, e.g. rgb-icc(0,0,0,press,0,0,0,1) for a CMYK profile named press.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="rendering-intent">
                <xs:annotation>
                    <xs:documentation compat:feature="rendering-intent on fo:color-profile"
                                      compat:status="unsupported" compat:fop="2.12"
                                      compat:evidence="source area-tree-test">
                        Specifies the rendering intent in XSL-FO, e.g. relative-colorimetric.

                        FOP 2.12: Unsupported. The FO color-expression path uses the declared profile URI but does not pass the FO intent property.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="bookmark-tree">
        <xs:annotation><xs:documentation>PDF outline tree. Place it after fo:declarations (if present) and before the page sequences.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:sequence><xs:element ref="fo:bookmark" maxOccurs="unbounded"/></xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="bookmark">
        <xs:annotation>
            <xs:documentation>A PDF outline entry: title followed by optional nested bookmarks. Set internal-destination to the ID of the target FO.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence><xs:element ref="fo:bookmark-title"/><xs:element ref="fo:bookmark" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
            <xs:attribute name="internal-destination" type="xs:NCName"><xs:annotation><xs:documentation>Target formatting object ID, e.g. "chapter-one".</xs:documentation></xs:annotation></xs:attribute>
            <xs:attribute name="external-destination" type="xs:string">
                <xs:annotation>
                    <xs:documentation compat:feature="fo:bookmark with external-destination"
                                      compat:status="unsupported" compat:fop="2.12"
                                      compat:evidence="source pdf-test">
                        External outline target in XSL-FO.

                        FOP 2.12: Unsupported. An external-only bookmark fails during PDF generation. Use an internal bookmark and an external fo:basic-link in the body.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="starting-state">
                <xs:annotation><xs:documentation>Show or hide nested entries initially. This changes outline expansion, not page visibility.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="show"/><xs:enumeration value="hide"/></xs:restriction></xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="bookmark-title">
        <xs:annotation>
            <xs:documentation compat:feature="fo:bookmark-title styling"
                              compat:status="unsupported" compat:fop="2.12"
                              compat:evidence="source pdf-test">
                Text displayed in the PDF outline.

                FOP 2.12: Unsupported. The PDF outline does not apply FO color, font style or weight.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="fo:accessibility-properties"/>
            <xs:attributeGroup ref="fo:font-properties"/>
            <xs:attribute name="color" type="fo:color_Type">
                <xs:annotation><xs:documentation>Outline text color in XSL-FO. See bookmark-title for FOP styling limitations.</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="layout-master-set">
        <xs:annotation>
            <xs:documentation>
                Defines named page layouts and master sequences. A page-sequence selects one by master-reference.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="fo:page-sequence-master">
                    <xs:annotation>
                        <xs:documentation>
                            Defines a sequence of page masters to be used for formatting a page sequence.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element ref="fo:simple-page-master">
                    <xs:annotation>
                        <xs:documentation>
                            Defines a simple page layout with regions for content.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element ref="fo:simple-page-master"/>
                    <xs:element ref="fo:page-sequence-master"/>
                </xs:choice>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="page-sequence-master">
        <xs:annotation>
            <xs:documentation>
                Selects a page master for each page in a sequence, for example a different master for the first, odd, or even page.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:choice maxOccurs="unbounded">
                <xs:element ref="fo:single-page-master-reference">
                    <xs:annotation>
                        <xs:documentation>
                            References a single page master to be used once in the sequence.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element ref="fo:repeatable-page-master-reference">
                    <xs:annotation>
                        <xs:documentation>
                            References a page master that can be used multiple times in the sequence.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element ref="fo:repeatable-page-master-alternatives">
                    <xs:annotation>
                        <xs:documentation>
                            Defines a set of alternative page masters that can be used based on conditions.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:attribute name="master-name" type="xs:NCName" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the name of the page sequence master, which is used to reference it from a page-sequence.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="single-page-master-reference">
        <xs:annotation>
            <xs:documentation>
                Uses the named simple-page-master for exactly one page.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="master-reference" type="xs:NCName" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the name of the simple-page-master being referenced.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="repeatable-page-master-reference">
        <xs:annotation>
            <xs:documentation>
                Uses the same master for successive pages. Set maximum-repeats to limit its use.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="master-reference" type="xs:NCName" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the name of the simple-page-master being referenced.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="maximum-repeats">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the maximum number of times the referenced page master can be used. If not specified, there is no limit.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="repeatable-page-master-alternatives">
        <xs:annotation>
            <xs:documentation>
                Chooses the first matching conditional master for each page. Put a fallback with no conditions last.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element maxOccurs="unbounded" ref="fo:conditional-page-master-reference">
                    <xs:annotation>
                        <xs:documentation>
                            References a page master to be used when certain conditions are met.
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="maximum-repeats">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the maximum number of times the set of alternatives can be used. If not specified, there is no limit.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="conditional-page-master-reference">
        <xs:annotation>
            <xs:documentation>
                Chooses a master when the page position, parity, and blank-page conditions match.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="master-reference" type="xs:NCName" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the name of the simple-page-master being referenced.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="page-position">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the position of the page in the sequence. Values include: first (first page), last (last page), rest (all pages except first and last), any (any position), and inherit.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="first"/>
                        <xs:enumeration value="last"/>
                        <xs:enumeration value="rest"/>
                        <xs:enumeration value="any"/>
                        <xs:enumeration value="inherit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="odd-or-even">
                <xs:annotation>
                    <xs:documentation>
                        Specifies whether the page is odd-numbered or even-numbered. Values include: odd, even, any, and inherit.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="odd"/>
                        <xs:enumeration value="even"/>
                        <xs:enumeration value="any"/>
                        <xs:enumeration value="inherit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="blank-or-not-blank">
                <xs:annotation>
                    <xs:documentation>
                        Specifies whether the page is blank or not. Values include: blank (page has no content), not-blank (page has content), any, and inherit.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="blank"/>
                        <xs:enumeration value="not-blank"/>
                        <xs:enumeration value="any"/>
                        <xs:enumeration value="inherit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="simple-page-master">
        <xs:annotation>
            <xs:documentation compat:feature="fo:simple-page-master"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="source runtime-probe">
                Defines page size, margins, and regions. Use page-width="210mm" and page-height="297mm" for A4. Include region-body; add optional side regions for repeating content.

                FOP 2.12: Partial. A table continuing onto a narrower page can retain its old width. Break before the table or keep the page widths consistent.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:region-body"/>
                <xs:element minOccurs="0" ref="fo:region-before"/>
                <xs:element minOccurs="0" ref="fo:region-after"/>
                <xs:element minOccurs="0" ref="fo:region-start"/>
                <xs:element minOccurs="0" ref="fo:region-end"/>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element ref="pdf:pagepiece"/>
                    <xs:element ref="pdf:page"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="fo:margin-properties-block"/>
            <xs:attribute ref="fox:scale"/>
            <xs:attribute ref="fox:bleed"/>
            <xs:attribute ref="fox:crop-offset"/>
            <xs:attribute ref="fox:crop-box"/>
            <xs:attribute name="master-name" type="xs:NCName" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the name of the page master, which is used to reference it from a page-sequence or page-sequence-master.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="page-height">
                <xs:annotation>
                    <xs:documentation compat:feature="page-height=&quot;indefinite&quot;"
                                      compat:status="unsupported" compat:fop="2.12"
                                      compat:evidence="source area-tree-test">
                        Specifies the height of the page. Can be specified as a length (e.g., "29.7cm" for A4) or as "auto".

                        FOP 2.12: Unsupported. A single indefinite page height produces a zero-height page; use a fixed length or auto.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="page-width">
                <xs:annotation>
                    <xs:documentation compat:feature="page-width=&quot;indefinite&quot;"
                                      compat:status="unsupported" compat:fop="2.12"
                                      compat:evidence="source area-tree-test">
                        Specifies the width of the page. Can be specified as a length (e.g., "21cm" for A4) or as "auto".

                        FOP 2.12: Unsupported. A single indefinite page width produces a zero-width page; use a fixed length or auto.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="reference-orientation">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the rotation of the coordinate system for the page. The value is the number of degrees of rotation (counterclockwise) applied to the reference-orientation.
                        Write a number without a unit, e.g. "90".
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="0"/>
                        <xs:enumeration value="90"/>
                        <xs:enumeration value="180"/>
                        <xs:enumeration value="270"/>
                        <xs:enumeration value="-90"/>
                        <xs:enumeration value="-180"/>
                        <xs:enumeration value="-270"/>
                        <xs:enumeration value="inherit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="writing-mode">
                <xs:annotation>
                    <xs:documentation>
                        Sets the page's inline and block progression. Use lr-tb for left-to-right text, rl-tb for right-to-left text, or tb-rl and tb-lr for vertical lines.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="lr-tb"/>
                        <xs:enumeration value="rl-tb"/>
                        <xs:enumeration value="tb-rl"/>
                        <xs:enumeration value="tb-lr"/>
                        <xs:enumeration value="lr"/>
                        <xs:enumeration value="rl"/>
                        <xs:enumeration value="tb"/>
                        <xs:enumeration value="inherit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:attributeGroup name="region-properties">
        <xs:annotation><xs:documentation>Shared properties of page-master regions: name, background and area controls.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="fo:border-padding-background-properties"/>
        <xs:attributeGroup ref="fo:area-properties"/>
        <xs:attribute name="region-name">
            <xs:annotation><xs:documentation>Name used by fo:flow or fo:static-content. Omit for the default name, e.g. xsl-region-body.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:element name="region-body">
        <xs:annotation>
            <xs:documentation>
                Main region for fo:flow. Use column-count and column-gap for columns; set margins to reserve space for headers or footers.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:region-properties"/>
            <xs:attributeGroup ref="fo:margin-properties-CSS"/>
            <xs:attribute name="column-count">
                <xs:annotation><xs:documentation>Number of body columns, e.g. 2. The default is 1.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="column-gap">
                <xs:annotation><xs:documentation>Space between body columns, e.g. "8mm".</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:attributeGroup name="side-region-properties">
        <xs:annotation><xs:documentation>Dimensions and corner precedence of the side regions outside the main body.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="fo:region-properties"/>
        <xs:attribute name="extent">
            <xs:annotation><xs:documentation>Side region width or height, e.g. "12mm" for a header. Reserve matching space in region-body with a margin.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="precedence">
            <xs:annotation><xs:documentation>Set true on a before or after region to let it extend over the corners next to start/end regions.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="true"/>
                    <xs:enumeration value="false"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:element name="region-before">
        <xs:annotation>
            <xs:documentation>
                Before-side region, normally the header. Set extent and supply its content in fo:static-content with flow-name="xsl-region-before" unless you renamed the region.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:side-region-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="region-after">
        <xs:annotation>
            <xs:documentation>
                After-side region, normally the footer. Set extent and supply its content in fo:static-content with flow-name="xsl-region-after" unless you renamed the region.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:side-region-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="region-start">
        <xs:annotation>
            <xs:documentation>
                Start-side region: left in left-to-right layout, right in right-to-left layout. Set extent and match its name in fo:static-content.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:side-region-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="region-end">
        <xs:annotation>
            <xs:documentation>
                End-side region: right in left-to-right layout, left in right-to-left layout. Set extent and match its name in fo:static-content.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:side-region-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="page-sequence">
        <xs:annotation>
            <xs:documentation>
                Lays out a main flow using the named master. Add optional static-content for repeating headers or footers. Use initial-page-number to control the first displayed number.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" ref="fo:title"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="fo:static-content"/>
                <xs:element ref="fo:flow"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID">
                <xs:annotation>
                    <xs:documentation>
                        Specifies a unique identifier for the page-sequence, which can be used for referencing or linking to this section of the document.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="master-reference" type="xs:NCName" use="required">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the name of the page-master or page-sequence-master that defines the layout for this sequence of pages. This attribute is required and must reference a master-name defined in the layout-master-set.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="initial-page-number">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the initial page number for this sequence. Values can be a number, "auto", "auto-odd", "auto-even", or "inherit". If not specified, page numbering continues from the previous sequence.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="force-page-count">
                <xs:annotation>
                    <xs:documentation>
                        Add blank pages to meet a page-count or final-number constraint. For example, even makes the sequence length even; end-on-even makes the final displayed page number even. FOP 2.12 extends this with doubly-even (length divisible by four) and doubly-odd (length is three modulo four), plus end-on-doubly-even and end-on-doubly-odd for the same rules applied to the final displayed number.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="auto"/>
                        <xs:enumeration value="even"/>
                        <xs:enumeration value="odd"/>
                        <xs:enumeration value="end-on-even"/>
                        <xs:enumeration value="end-on-odd"/>
                        <xs:enumeration value="doubly-even"/>
                        <xs:enumeration value="doubly-odd"/>
                        <xs:enumeration value="end-on-doubly-even"/>
                        <xs:enumeration value="end-on-doubly-odd"/>
                        <xs:enumeration value="no-force"/>
                        <xs:enumeration value="inherit"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="format">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the format for page numbers. Common values include "1" for decimal numbers, "i" for lowercase Roman numerals, "I" for uppercase Roman numerals, "a" for lowercase letters, and "A" for uppercase letters.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="letter-value">
                <xs:annotation>
                    <xs:documentation>
                        Specifies how alphabetic numbering should be interpreted when the format attribute specifies an alphabetic sequence. This is particularly relevant for languages with different alphabetic traditions.
                    </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:token">
                        <xs:enumeration value="auto"/>
                        <xs:enumeration value="alphabetic"/>
                        <xs:enumeration value="traditional"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="grouping-separator">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the character used as a grouping separator for page numbers (e.g., the comma in "1,000").
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="grouping-size">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the number of digits that are grouped together between grouping separators (e.g., "3" for grouping thousands).
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="fo:inheritable-properties"/>
            <xs:attribute ref="fox:number-conversion-features"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="title">
        <xs:annotation>
            <xs:documentation>
                Identifies the title of one page sequence for a formatter that uses it. It is not a PDF outline entry or the PDF document title; use fo:bookmark-tree for the outline and XMP or FOUserAgent for the document title.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:group ref="fo:basic-inlines"/>
                <xs:group ref="fo:wrappers"/>
            </xs:choice>
            <xs:attributeGroup ref="fo:inheritable-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:attributeGroup name="flow-properties">
        <xs:annotation>
            <xs:documentation>
                Defines attributes common to flow and static-content elements. These properties control the identification and behavior of content flows in the document.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="id" type="xs:ID">
            <xs:annotation>
                <xs:documentation>
                    Specifies a unique identifier for the flow or static-content element.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="flow-name" type="xs:NCName" use="required">
            <xs:annotation>
                <xs:documentation>
                    Specifies the name of the flow or static-content. This name is used to associate the flow with a region in a page-master. Common values include "xsl-region-body", "xsl-region-before", "xsl-region-after", "xsl-region-start", and "xsl-region-end".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="fo:inheritable-properties"/>
    </xs:attributeGroup>
    <xs:element name="static-content">
        <xs:annotation>
            <xs:documentation>
                Repeats content in a named region, such as a page header or footer. Match flow-name to the region-name in the page master.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:group maxOccurs="unbounded" ref="fo:blocks"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:flow-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="flow">
        <xs:annotation>
            <xs:documentation>
                Main content that paginates across region-body. Use flow-name="xsl-region-body" unless you renamed the region.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:group ref="fo:blocks" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:flow-properties"/>
            <xs:attribute ref="fox:disable-column-balancing"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="block">
        <xs:annotation>
            <xs:documentation>
                Lays out a paragraph, heading, or other block of content. Accepts text, inline elements, and nested blocks.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="fo:initial-property-set" minOccurs="0"/>
                <xs:group ref="fo:mixed-level" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:block-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="block-container">
        <xs:annotation>
            <xs:documentation compat:feature="fo:block-container"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="source area-tree-test">
                Creates a new layout area for blocks. For an absolutely positioned box, set absolute-position="absolute" and give offsets such as top="10pt" and left="20pt".

                FOP 2.12: Partial. An automatically sized container can exceed block-progression-dimension.maximum. Set a fixed height if required.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:group maxOccurs="unbounded" ref="fo:blocks"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:block-properties"/>
            <xs:attribute ref="fox:transform"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="bidi-override">
        <xs:annotation>
            <xs:documentation>
                Overrides normal bidirectional ordering for the enclosed text. For example, use direction="rtl" with unicode-bidi="bidi-override" when a run must read right to left.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group minOccurs="0" maxOccurs="unbounded" ref="fo:inlines"/>
            <xs:attributeGroup ref="fo:inline-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="character">
        <xs:annotation>
            <xs:documentation>
                Formats one character separately from surrounding text, for example &lt;fo:character character="§"/&gt;.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="character" use="required">
                <xs:annotation><xs:documentation>Character represented by this inline object, e.g. "§"; use XML character references when needed.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="fo:empty-inline-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="initial-property-set">
        <xs:annotation>
            <xs:documentation compat:feature="fo:initial-property-set"
                              compat:status="unsupported" compat:fop="2.12"
                              compat:evidence="source area-tree-test">
                Sets first-line formatting inside fo:block in XSL-FO. Put it before visible content.

                FOP 2.12: Unsupported. Style the initial content explicitly (e.g. fo:inline).
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:empty-inline-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="external-graphic">
        <xs:annotation>
            <xs:documentation>
                Displays an image inline. Set src="url('chart.svg')" and content-width if you need to resize it. Use fox:alt-text for tagged PDF.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:graphic-properties"/>
            <xs:attribute use="required" name="src">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the URI of the external graphic resource to be included.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="instream-foreign-object">
        <xs:annotation>
            <xs:documentation>
                Embeds XML as an inline object, typically svg:svg. FOP renders SVG directly; other vocabularies such as MathML need an extension.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:any namespace="##other" processContents="lax"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:graphic-properties"/>
            <xs:anyAttribute namespace="##other" processContents="lax"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="inline">
        <xs:annotation>
            <xs:documentation>
                Formats a run of text without starting a new block. For example, use font-weight="bold" to emphasize a few words.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group minOccurs="0" maxOccurs="unbounded" ref="fo:mixed-level"/>
            <xs:attributeGroup ref="fo:inline-properties"/>
            <xs:attribute ref="fox:abbreviation"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="inline-container">
        <xs:annotation>
            <xs:documentation compat:feature="fo:inline-container"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="source runtime-probe">
                Places block content inside an inline box.

                FOP 2.12: Partial. Auto width emits a fallback warning; set inline-progression-dimension explicitly, e.g. "60pt".
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:group maxOccurs="unbounded" ref="fo:blocks"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:inline-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="leader">
        <xs:annotation>
            <xs:documentation>
                Fills inline space with dots, a rule, blank space, or repeated content. Use leader-pattern="dots" to connect a contents entry to its number.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group minOccurs="0" maxOccurs="unbounded" ref="fo:inlines"/>
            <xs:attributeGroup ref="fo:inline-properties"/>
            <xs:attribute ref="fox:rule-style"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="page-number">
        <xs:annotation>
            <xs:documentation>
                Prints the current page number using the page sequence’s format. Common in headers and footers.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:empty-inline-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="page-number-citation">
        <xs:annotation>
            <xs:documentation compat:feature="fo:page-number-citation"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="source pdf-test">
                Prints the first page number for the object named by ref-id. Set id on a target that generates an area.

                FOP 2.12: Partial. A forward citation can widen when resolved, but FOP does not rebreak the line.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="fo:empty-inline-properties"/>
            <xs:attribute name="ref-id" use="required">
                <xs:annotation><xs:documentation>ID of the formatting object being cited, e.g. ref-id="results".</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="table-and-caption">
        <xs:annotation>
            <xs:documentation compat:feature="fo:table-and-caption"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="source pdf-test">
                Keeps a table and its optional caption in one layout object. Put fo:table-caption before fo:table.

                FOP 2.12: Partial. The caption renders before the table. Initial support in 2.12.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element minOccurs="0" ref="fo:table-caption"/>
                <xs:element ref="fo:table"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:block-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="table-caption">
        <xs:annotation>
            <xs:documentation source="https://www.w3.org/TR/xsl11/#fo_table-caption">
                Contains block content for the caption of a table. Use only inside fo:table-and-caption, before fo:table.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:group maxOccurs="unbounded" ref="fo:blocks"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:block-properties"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="table">
        <xs:annotation>
            <xs:documentation compat:feature="fo:table"
                              compat:status="partial" compat:fop="2.12"
                              compat:evidence="pdf-test source">
                Lays out columns and rows. Put optional column, header, and footer declarations before one or more table bodies.

                FOP 2.12: Partial. Use table-layout="fixed" with explicit column widths.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="fo:marker" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="fo:table-column"/>
                <xs:element minOccurs="0" ref="fo:table-header"/>
                <xs:element minOccurs="0" ref="fo:table-footer"/>
                <xs:element maxOccurs="unbounded" ref="fo:table-body"/>
            </xs:sequence>
            <xs:attributeGroup ref="fo:block-properties"/>
            <xs:attribute ref="fox:widow-content-limit"/>
            <xs:attribute ref="fox:orphan-content-limit"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="table-column">
        <xs:annotation>
            <xs:documentation>
                Assigns a width and properties to a table column. Use column-width="60pt" or proportional-column-width(1) in a fixed layout table.
            </xs:documentation>
