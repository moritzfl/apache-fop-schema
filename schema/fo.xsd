        <xs:attribute name="space-before">
            <xs:annotation>
                <xs:documentation compat:feature="space-before"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Space before a block, e.g. "8pt". Adjacent spaces can collapse; see the precedence and conditionality components.

                    FOP 2.12: Partial. A fixed-height fo:block-container can compress the gap below its specified minimum.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-before.minimum">
            <xs:annotation><xs:documentation>Smallest allowed space before, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-before.optimum">
            <xs:annotation><xs:documentation>Preferred space before, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-before.maximum">
            <xs:annotation><xs:documentation>Largest allowed space before, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-before.precedence">
