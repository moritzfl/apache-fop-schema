            <xs:annotation><xs:documentation>Select the main baseline for areas in this context, e.g. alphabetic for Latin text.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="use-script"/>
                    <xs:enumeration value="no-change"/>
                    <xs:enumeration value="reset-size"/>
                    <xs:enumeration value="ideographic"/>
                    <xs:enumeration value="alphabetic"/>
                    <xs:enumeration value="hanging"/>
                    <xs:enumeration value="mathematical"/>
                    <xs:enumeration value="central"/>
                    <xs:enumeration value="middle"/>
                    <xs:enumeration value="text-after-edge"/>
                    <xs:enumeration value="text-before-edge"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="vertical-align">
            <xs:annotation>
                <xs:documentation>Shorthand for inline baseline alignment, e.g. super or sub. Percentage offsets use the inline's line-height: on a 12pt line, vertical-align="100%" raises the inline by 12pt. Use display-align to center a block within a table cell.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="line-height-properties">
        <xs:annotation><xs:documentation>Line height and the components controlling its flexible space range.</xs:documentation></xs:annotation>
        <xs:attribute name="line-height">
            <xs:annotation><xs:documentation>Line box height, e.g. "14pt" or "1.2" times font size.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="line-height.minimum">
            <xs:annotation><xs:documentation>Smallest allowed line height, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="line-height.optimum">
            <xs:annotation><xs:documentation>Preferred line height, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="line-height.maximum">
            <xs:annotation><xs:documentation>Largest allowed line height, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="line-height.precedence">
            <xs:annotation><xs:documentation>Priority of line height when adjacent spaces compete. A higher integer takes precedence; force means the space is always included.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="line-height.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard line height at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
