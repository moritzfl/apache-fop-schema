<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        targetNamespace = "http://www.w3.org/1999/XSL/Format"
        xmlns:fo="http://www.w3.org/1999/XSL/Format"
        xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:compat="urn:apache-fop-schema:compatibility"
        xmlns:x="adobe:ns:meta/"
        xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
        xmlns:pdf="http://xmlgraphics.apache.org/fop/extensions/pdf"
        elementFormDefault="qualified">
    <xs:annotation>
        <xs:documentation source="https://www.w3.org/TR/xsl11/">
            XSL-FO 1.1 authoring schema focused on Apache FOP and PDF output. Validation checks markup, not whether FOP renders every feature.

            Apache FOP documentation: https://xmlgraphics.apache.org/fop/
            German XSL-FO reference: https://www.data2type.de/xml-xslt-xslfo/xsl-fo/xslfo-referenz
        </xs:documentation>
    </xs:annotation>
    <xs:annotation>
        <xs:documentation compat:feature="fo:flow-assignment"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot assign an ordered set of flows to regions with this object.
        </xs:documentation>
        <xs:documentation compat:feature="fo:flow-map"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Instead of mapping flows to regions, use one fo:flow per sequence and fo:static-content for repeating regions.
        </xs:documentation>
        <xs:documentation compat:feature="fo:flow-name-specifier"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot name a source flow in an fo:flow-source-list.
        </xs:documentation>
        <xs:documentation compat:feature="fo:flow-source-list"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot list the flows that feed an fo:flow-assignment.
        </xs:documentation>
        <xs:documentation compat:feature="fo:flow-target-list"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot list the receiving regions in an fo:flow-assignment.
        </xs:documentation>
        <xs:documentation compat:feature="fo:folio-prefix"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. For a prefix on printed page numbers, put text before fo:page-number in static content.
        </xs:documentation>
        <xs:documentation compat:feature="fo:folio-suffix"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. For a suffix on printed page numbers, put text after fo:page-number in static content.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-key-reference"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. FOP cannot collect page references by index key. Build index entries outside the formatter.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-page-citation-list"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. FOP cannot assemble a sorted list of page references for an index entry.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-page-citation-list-separator"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. No configurable separator between generated index citations, e.g. the comma in “3, 7–9”.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-page-citation-range-separator"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. No configurable separator within a generated index range, e.g. the dash in “7–9”.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-page-number-prefix"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot prepend text to generated index citations with this object.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-page-number-suffix"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot append text to generated index citations with this object.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-range-begin"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot start a range associated with an index key.
        </xs:documentation>
        <xs:documentation compat:feature="fo:index-range-end"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot close a range opened by fo:index-range-begin.
        </xs:documentation>
        <xs:documentation compat:feature="fo:page-sequence-wrapper"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Set inherited properties on each page sequence; this grouping object is not registered.
        </xs:documentation>
        <xs:documentation compat:feature="fo:region-name-specifier"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Cannot name a destination region in an fo:flow-target-list.
        </xs:documentation>
        <xs:documentation compat:feature="fo:scaling-value-citation"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. FOP cannot print the scale factor of a referenced fo:external-graphic.
        </xs:documentation>
        <xs:documentation compat:feature="size shorthand"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Instead of the size shorthand, set page-width and page-height on the page master.
        </xs:documentation>
    </xs:annotation>
    <xs:import namespace="http://xmlgraphics.apache.org/fop/extensions" schemaLocation="fox.xsd"/>
    <xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>
    <xs:import namespace="adobe:ns:meta/" schemaLocation="xmpmeta.xsd"/>
    <xs:import namespace="http://www.w3.org/1999/02/22-rdf-syntax-ns#" schemaLocation="rdf.xsd"/>
    <xs:import namespace="http://xmlgraphics.apache.org/fop/extensions/pdf" schemaLocation="pdf.xsd"/>
    <xs:group name="basic-inlines">
        <xs:annotation><xs:documentation>Formatting objects that produce inline areas, such as inline text, links, and images.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:element ref="fo:bidi-override"/>
            <xs:element ref="fo:character"/>
            <xs:element ref="fo:external-graphic"/>
            <xs:element ref="fo:instream-foreign-object"/>
            <xs:element ref="fo:inline"/>
            <xs:element ref="fo:inline-container"/>
            <xs:element ref="fo:leader"/>
            <xs:element ref="fo:page-number"/>
            <xs:element ref="fo:page-number-citation"/>
            <xs:element ref="fo:basic-link"/>
            <xs:element ref="fo:multi-toggle"/>
            <xs:element ref="fo:page-number-citation-last"/>
        </xs:choice>
    </xs:group>
    <xs:group name="basic-blocks">
        <xs:annotation><xs:documentation>Formatting objects that produce block areas, such as blocks, lists and tables.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:element ref="fo:block"/>
            <xs:element ref="fo:block-container"/>
            <xs:element ref="fo:table-and-caption"/>
            <xs:element ref="fo:table"/>
            <xs:element ref="fo:list-block"/>
        </xs:choice>
    </xs:group>
    <xs:group name="out-of-lines">
        <xs:annotation><xs:documentation>Objects whose content is placed outside the normal line flow, such as footnotes and change bars.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:element ref="fo:float"/>
            <xs:element ref="fo:footnote"/>
            <xs:element ref="fo:change-bar-begin"/>
            <xs:element ref="fo:change-bar-end"/>
        </xs:choice>
    </xs:group>
    <xs:group name="wrappers">
        <xs:annotation><xs:documentation>Objects that wrap other content or retrieve content at layout time. Marker placement also depends on the parent.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:element ref="fo:wrapper"/>
            <xs:element ref="fo:retrieve-marker"/>
            <xs:element ref="fo:multi-switch"/>
            <xs:element ref="fo:multi-properties"/>
            <xs:element ref="fo:retrieve-table-marker"/>
        </xs:choice>
    </xs:group>
    <xs:group name="blocks">
        <xs:annotation><xs:documentation>Block-level content, including wrappers and out-of-line objects.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:group ref="fo:basic-blocks"/>
            <xs:group ref="fo:out-of-lines"/>
            <xs:group ref="fo:wrappers"/>
            <xs:element ref="fox:destination"/>
        </xs:choice>
    </xs:group>
    <xs:group name="inlines">
        <xs:annotation><xs:documentation>Inline, wrapper and out-of-line objects. A named destination creates no visible area.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:group ref="fo:basic-inlines"/>
            <xs:group ref="fo:out-of-lines"/>
            <xs:group ref="fo:wrappers"/>
            <xs:element ref="fox:destination"/>
        </xs:choice>
    </xs:group>
    <xs:group name="mixed-level">
        <xs:annotation><xs:documentation>Objects that can appear in mixed block and inline content.</xs:documentation></xs:annotation>
        <xs:choice>
            <xs:group ref="fo:inlines"/>
            <xs:group ref="fo:basic-blocks"/>
        </xs:choice>
    </xs:group>
    <xs:attributeGroup name="accessibility-properties">
        <xs:annotation>
            <xs:documentation>
                Defines attributes related to accessibility features. These attributes provide additional information for assistive technologies to improve document accessibility.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="source-document">
            <xs:annotation>
                <xs:documentation compat:feature="source-document"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Identifies the source document containing the content being formatted.

                    FOP 2.12: Unsupported. Does not preserve a source link in PDF.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="role">
            <xs:annotation>
                <xs:documentation>
                    Specifies the role of the element in the document structure, which can be used by assistive technologies.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="relative-position-properties">
        <xs:annotation>
            <xs:documentation>
                Defines attributes related to the relative positioning of elements. These attributes control how elements are positioned relative to their normal position in the document flow.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="relative-position">
            <xs:annotation>
                <xs:documentation compat:feature="relative-position"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Specifies the type of positioning used for an element. Values include: auto, static, relative, and inherit.

                    FOP 2.12: Unsupported. Use fo:block-container absolute-position="absolute" for positioned areas where appropriate.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="static"/>
                    <xs:enumeration value="relative"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="position">
            <xs:annotation>
                <xs:documentation>
                    Specifies the positioning method used for an element. Values include: static, relative, absolute, fixed, and inherit.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="static"/>
                    <xs:enumeration value="relative"/>
                    <xs:enumeration value="absolute"/>
                    <xs:enumeration value="fixed"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="top">
            <xs:annotation>
                <xs:documentation>
                    Specifies the top offset for positioned elements. Valid values include a length with units (px, pt, mm, cm, in, em, %), "auto", or "inherit".
                    Examples: "10pt", "2cm", "5%", "auto", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:union>
                    <xs:simpleType>
                        <xs:restriction base="fo:length_Type"/>
                    </xs:simpleType>
                    <xs:simpleType>
                        <xs:restriction base="xs:token">
                            <xs:enumeration value="auto"/>
                            <xs:enumeration value="inherit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:union>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="right">
            <xs:annotation>
                <xs:documentation>
                    Specifies the right offset for positioned elements. Valid values include a length with units (px, pt, mm, cm, in, em, %), "auto", or "inherit".
                    Examples: "10pt", "2cm", "5%", "auto", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:union>
                    <xs:simpleType>
                        <xs:restriction base="fo:length_Type"/>
                    </xs:simpleType>
                    <xs:simpleType>
                        <xs:restriction base="xs:token">
                            <xs:enumeration value="auto"/>
                            <xs:enumeration value="inherit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:union>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="bottom">
            <xs:annotation>
                <xs:documentation>
                    Specifies the bottom offset for positioned elements. Valid values include a length with units (px, pt, mm, cm, in, em, %), "auto", or "inherit".
                    Examples: "10pt", "2cm", "5%", "auto", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:union>
                    <xs:simpleType>
                        <xs:restriction base="fo:length_Type"/>
                    </xs:simpleType>
                    <xs:simpleType>
                        <xs:restriction base="xs:token">
                            <xs:enumeration value="auto"/>
                            <xs:enumeration value="inherit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:union>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="left">
            <xs:annotation>
                <xs:documentation>
                    Specifies the left offset for positioned elements. Valid values include a length with units (px, pt, mm, cm, in, em, %), "auto", or "inherit".
                    Examples: "10pt", "2cm", "5%", "auto", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:union>
                    <xs:simpleType>
                        <xs:restriction base="fo:length_Type"/>
                    </xs:simpleType>
                    <xs:simpleType>
                        <xs:restriction base="xs:token">
                            <xs:enumeration value="auto"/>
                            <xs:enumeration value="inherit"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:union>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="absolute-or-relative-position-properties">
        <xs:annotation>
            <xs:documentation>
                Defines attributes related to both absolute and relative positioning of elements. This group combines absolute positioning attributes with the relative positioning attributes.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="absolute-position">
            <xs:annotation>
                <xs:documentation>
                    Specifies the type of absolute positioning used for an element. Values include: auto, absolute, fixed, and inherit.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="absolute"/>
                    <xs:enumeration value="fixed"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attributeGroup ref="fo:relative-position-properties"/>
    </xs:attributeGroup>
    <!-- Type definitions for pattern-based restrictions -->
    <xs:simpleType name="use_font_metrics_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type that allows only the value "use-font-metrics". This is used for properties that can use font metrics for their value.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:enumeration value="use-font-metrics"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="length_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type for length values with units. Valid length values include a number (possibly with a decimal point) followed by a unit (px, pt, pc, mm, cm, in, em, or %; unitless 0 is also accepted). Examples: "12pt", "1.5cm", "80%".
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="0|[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)(px|pt|pc|mm|cm|in|em|mpt|%)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="percentage_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type for percentage values. Valid percentage values include a number (possibly with a decimal point) followed by a percent sign (%). Examples: "50%", "100%", "33.3%".
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[+\-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)%"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="inherit_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type that allows only the value "inherit". This is used for properties that can inherit their value from a parent element.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:token">
            <xs:enumeration value="inherit"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="leader_pattern_width_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type for the leader-pattern-width property, which can be specified as "use-font-metrics", a length, a percentage, or "inherit".
            </xs:documentation>
        </xs:annotation>
        <xs:union memberTypes="fo:use_font_metrics_Type fo:length_Type fo:percentage_Type fo:inherit_Type"/>
    </xs:simpleType>

    <xs:simpleType name="color_Type">
        <xs:annotation><xs:documentation>Color keyword, hexadecimal color or FO color expression. Examples: steelblue, #00ffff80 (FOP RGBA hex), rgb(255,0,0), cmyk(0%,0%,20%,40%), transparent, inherit. FOP checks the expression and available color profiles when rendering.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:token">
            <xs:pattern value="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|[a-zA-Z][a-zA-Z0-9-]*|[a-zA-Z][a-zA-Z0-9-]*\(.+\)"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="angle_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type for angle values. Valid values include a number followed by a unit (deg, grad, rad).
                Examples: "90deg", "100grad", "1.57rad".
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[\+\-]?\d+\.?\d*(deg|grad|rad)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="angle_or_inherit_Type">
        <xs:annotation><xs:documentation>An angle literal or inherit.</xs:documentation></xs:annotation>
        <xs:union memberTypes="fo:angle_Type fo:inherit_Type"/>
    </xs:simpleType>

    <!-- Frequency type definitions -->
    <xs:simpleType name="frequency_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type for frequency values. Valid values include a number followed by a unit (Hz, kHz).
                Examples: "100Hz", "2kHz".
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\d+\.?\d*(Hz|kHz)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="frequency_or_inherit_Type">
        <xs:annotation><xs:documentation>A frequency literal or inherit.</xs:documentation></xs:annotation>
        <xs:union memberTypes="fo:frequency_Type fo:inherit_Type"/>
    </xs:simpleType>

    <!-- Time type definitions -->
    <xs:simpleType name="time_Type">
        <xs:annotation>
            <xs:documentation>
                Defines a type for time values. Valid values include a number followed by a unit (ms, s).
                Examples: "100ms", "2s".
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\d+\.?\d*(ms|s)"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="time_or_inherit_Type">
        <xs:annotation><xs:documentation>A duration literal or inherit.</xs:documentation></xs:annotation>
        <xs:union memberTypes="fo:time_Type fo:inherit_Type"/>
    </xs:simpleType>

    <xs:attributeGroup name="aural-properties">
        <xs:annotation>
            <xs:documentation compat:feature="Common aural properties"
                              compat:status="unsupported" compat:fop="2.12"
                              compat:evidence="source runtime-probe">
                Defines attributes related to aural (speech) rendering of content. These properties control how content is presented by speech synthesizers and audio-based user agents.

                FOP 2.12: Unsupported. The PDF renderer does not generate aural output. These declarations describe standard vocabulary, not PDF speech settings.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="azimuth">
            <xs:annotation>
                <xs:documentation>
                    Specifies the horizontal direction from which the sound should appear to come. Valid values include an angle with units (deg, grad, rad) or "inherit".
                    Examples: "90deg", "100grad", "1.57rad", "inherit".</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:angle_or_inherit_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="cue">
            <xs:annotation>
                <xs:documentation>
                    Shorthand property for setting cue-before and cue-after properties.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="cue-after">
            <xs:annotation>
                <xs:documentation>
                    Specifies a sound to be played after speaking an element's content.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="cue-before">
            <xs:annotation>
                <xs:documentation>
                    Specifies a sound to be played before speaking an element's content.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="elevation">
            <xs:annotation>
                <xs:documentation>
                    Specifies the vertical direction from which the sound should appear to come. Valid values include an angle with units (deg, grad, rad) or "inherit".
                    Examples: "45deg", "50grad", "0.78rad", "inherit".</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:angle_or_inherit_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="pause">
            <xs:annotation>
                <xs:documentation>
                    Shorthand property for setting pause-before and pause-after properties.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="pause-after">
            <xs:annotation>
                <xs:documentation>
                    Specifies a pause to be observed after speaking an element's content. Valid values include a time with units (ms, s) or "inherit".
                    Examples: "500ms", "2s", "inherit".</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:time_or_inherit_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="pause-before">
            <xs:annotation>
                <xs:documentation>
                    Specifies a pause to be observed before speaking an element's content. Valid values include a time with units (ms, s) or "inherit".
                    Examples: "500ms", "2s", "inherit".</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:time_or_inherit_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="pitch">
            <xs:annotation>
                <xs:documentation>
                    Specifies the average pitch (frequency) of the speaking voice. Valid values include a frequency with units (Hz, kHz) or "inherit".
                    Examples: "200Hz", "1kHz", "inherit".</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:frequency_or_inherit_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="pitch-range">
            <xs:annotation>
                <xs:documentation>
                    Specifies the variation in average pitch. A higher value indicates more variation.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="play-during">
