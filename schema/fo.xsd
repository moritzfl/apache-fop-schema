                <xs:restriction base="xs:token">
                    <xs:enumeration value="retain"/>
                    <xs:enumeration value="discard"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="line-height-shift-adjustment">
            <xs:annotation><xs:documentation>Whether a baseline shift increases the line’s height.</xs:documentation></xs:annotation>
        </xs:attribute>
