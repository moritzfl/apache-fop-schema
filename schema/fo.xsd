    <xs:attributeGroup name="line-related-properties">
        <xs:annotation><xs:documentation>Control line stacking, alignment, indentation, wrapping, white space, and bidirectional text.</xs:documentation></xs:annotation>
        <xs:attribute name="text-align">
            <xs:annotation>
                <xs:documentation compat:feature="text-align"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Align line content in a block: start, center, end or justify, e.g. text-align="end" for numeric cells.

                    FOP 2.12: Partial. inside acts like start and outside like end, regardless of the binding edge.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="center"/>
                    <xs:enumeration value="end"/>
                    <xs:enumeration value="justify"/>
                    <xs:enumeration value="inside"/>
                    <xs:enumeration value="outside"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="text-align-last">
            <xs:annotation>
                <xs:documentation compat:feature="text-align-last"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Alignment of the last line of a block; useful when preceding lines are justified.

                    FOP 2.12: Partial. inside acts like start and outside like end, regardless of the binding edge.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="relative"/>
                    <xs:enumeration value="start"/>
                    <xs:enumeration value="center"/>
                    <xs:enumeration value="end"/>
                    <xs:enumeration value="justify"/>
                    <xs:enumeration value="inside"/>
                    <xs:enumeration value="outside"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="text-indent">
