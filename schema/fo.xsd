        <xs:attribute name="space-end.optimum">
            <xs:annotation><xs:documentation>Preferred space end, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-end.maximum">
            <xs:annotation><xs:documentation>Largest allowed space end, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-end.precedence">
            <xs:annotation><xs:documentation>Priority of space end when adjacent spaces compete. A higher integer takes precedence; force means the space is always included.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-end.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard space end at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="retain"/>
                    <xs:enumeration value="discard"/>
