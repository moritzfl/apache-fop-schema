            <xs:annotation><xs:documentation>Physical margins using one to four lengths in CSS order. For example, "12pt 18pt" means 12pt top/bottom and 18pt left/right.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="margin-bottom">
            <xs:annotation><xs:documentation>Physical bottom margin, e.g. "10mm". Use logical space/indent properties for writing-mode-relative spacing.</xs:documentation></xs:annotation>
