        </xs:attribute>
        <xs:attribute name="space-before.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard space before at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="retain"/>
                    <xs:enumeration value="discard"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="start-indent">
            <xs:annotation><xs:documentation>Distance from the start edge of the reference area to the content, e.g. "18pt". Inherited.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="end-indent">
            <xs:annotation><xs:documentation>Distance from the end edge of the reference area to the content, e.g. "18pt". Inherited.</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="margin-properties-inline">
        <xs:annotation><xs:documentation>Margin and indent properties plus logical space before and after inline content in the inline progression direction.</xs:documentation></xs:annotation>
        <xs:attributeGroup ref="fo:margin-properties-block"/>
        <xs:attribute name="space-start">
            <xs:annotation>
                <xs:documentation>Space before an inline area in the inline progression direction. For example, space-start="14pt" on fo:inline inserts 14pt before its content in FOP PDF output.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-start.minimum">
            <xs:annotation><xs:documentation>Smallest allowed space start, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-start.optimum">
            <xs:annotation><xs:documentation>Preferred space start, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-start.maximum">
            <xs:annotation><xs:documentation>Largest allowed space start, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-start.precedence">
            <xs:annotation><xs:documentation>Priority of space start when adjacent spaces compete. A higher integer takes precedence; force means the space is always included.</xs:documentation></xs:annotation>
