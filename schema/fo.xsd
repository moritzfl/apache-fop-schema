            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-start-width.length">
            <xs:annotation>
                <xs:documentation>
                    Specifies the absolute width component of the start border. Valid values include a length with units (px, pt, mm, cm, in, em, %).
                    Examples: "1px", "2pt", "0.5cm".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-start-width.conditionality">
            <xs:annotation>
                <xs:documentation>
                    Specifies whether the start border width is conditional. When a border is conditional, it may be discarded at a page break.
                    Valid values: "discard" (may be discarded at a break) or "retain" (must be retained at a break).
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="border-style">
            <xs:annotation>
                <xs:documentation>
                    Shorthand property for setting the style of all four borders. Valid values include various border styles such as "none", "solid", "dotted", etc.
                    Examples: "solid", "dotted", "dashed", "double", "inherit".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-top">
            <xs:annotation>
                <xs:documentation>
                    Shorthand property for setting the width, style, and color of the top border. Valid values include combinations of width, style, and color values.
                    Examples: "1px solid black", "thin dotted red", "medium double #ff0000".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-top-color">
            <xs:annotation>
                <xs:documentation>
                    Specifies the color of the top border. Use a named color, hexadecimal color, FO color function, or "inherit".
                    Examples: "#ff0000", "rgb(255,0,0)", "red", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="fo:color_Type"/>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="border-top-style">
            <xs:annotation>
                <xs:documentation>
                    Specifies the style of the top border. Valid values include various border styles such as "none", "solid", "dotted", etc.
                    Examples: "solid", "dotted", "dashed", "double", "inherit".
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="none"/>
                    <xs:enumeration value="hidden"/>
                    <xs:enumeration value="dotted"/>
                    <xs:enumeration value="dashed"/>
                    <xs:enumeration value="solid"/>
                    <xs:enumeration value="double"/>
                    <xs:enumeration value="groove"/>
                    <xs:enumeration value="ridge"/>
                    <xs:enumeration value="inset"/>
                    <xs:enumeration value="outset"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="border-top-width">
            <xs:annotation>
                <xs:documentation>
                    Specifies the width of the top border. Valid values include a length with units (px, pt, mm, cm, in, em, %), predefined keywords (thin, medium, thick), or "inherit".
                    Examples: "1px", "2pt", "thin", "medium", "thick", "inherit".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-top-width.length">
            <xs:annotation>
                <xs:documentation>
                    Specifies the absolute width component of the top border. Valid values include a length with units (px, pt, mm, cm, in, em, %).
                    Examples: "1px", "2pt", "0.5cm".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-top-width.conditionality">
            <xs:annotation>
                <xs:documentation>
                    Specifies whether the top border width is conditional. When a border is conditional, it may be discarded at a page break.
                    Valid values: "discard" (may be discarded at a break) or "retain" (must be retained at a break).
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="border-width">
            <xs:annotation>
                <xs:documentation>
                    Shorthand property for setting the width of all four borders. Valid values include a length with units (px, pt, mm, cm, in, em, %), predefined keywords (thin, medium, thick), or "inherit".
                    Examples: "1px", "2pt", "thin", "medium", "thick", "inherit". Can also specify different values for each side: "1px 2px 3px 4px" (top, right, bottom, left).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding">
            <xs:annotation>
                <xs:documentation>
                    Shorthand property for setting padding on all four sides of an element. Valid values include a length with units (px, pt, mm, cm, in, em, %) or "inherit".
                    Examples: "5pt", "1cm", "inherit". Can also specify different values for each side: "1px 2px 3px 4px" (top, right, bottom, left).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-after">
            <xs:annotation>
                <xs:documentation>
                    Specifies the padding after an element in the block-progression-direction. Valid values include a length with units (px, pt, mm, cm, in, em, %) or "inherit".
                    Examples: "5pt", "1cm", "inherit".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-after.length">
            <xs:annotation>
                <xs:documentation>
                    Specifies the absolute length component of the padding after an element. Valid values include a length with units (px, pt, mm, cm, in, em, %).
                    Examples: "5pt", "1cm", "0.5in".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-after.conditionality">
            <xs:annotation>
                <xs:documentation>
                    Specifies whether the padding after an element is conditional. When padding is conditional, it may be discarded at a page break.
                    Valid values: "discard" (may be discarded at a break) or "retain" (must be retained at a break).
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-before">
            <xs:annotation><xs:documentation>Space between the content and before border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-before.length">
            <xs:annotation><xs:documentation>Length component of padding before, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-before.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding before at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-bottom">
            <xs:annotation><xs:documentation>Space between the content and bottom border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-bottom.length">
            <xs:annotation><xs:documentation>Length component of padding bottom, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-bottom.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding bottom at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-end">
            <xs:annotation><xs:documentation>Space between the content and end border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-end.length">
            <xs:annotation><xs:documentation>Length component of padding end, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-end.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding end at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-left">
            <xs:annotation><xs:documentation>Space between the content and left border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-left.length">
            <xs:annotation><xs:documentation>Length component of padding left, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-left.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding left at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-right">
            <xs:annotation><xs:documentation>Space between the content and right border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-right.length">
            <xs:annotation><xs:documentation>Length component of padding right, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-right.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding right at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-start">
            <xs:annotation><xs:documentation>Space between the content and start border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-start.length">
            <xs:annotation><xs:documentation>Length component of padding start, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-start.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding start at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="padding-top">
            <xs:annotation><xs:documentation>Space between the content and top border, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-top.length">
            <xs:annotation><xs:documentation>Length component of padding top, e.g. "4pt"; conditionality is set separately.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="padding-top.conditionality">
            <xs:annotation><xs:documentation>Whether to retain or discard padding top at a break. Use retain when the space or edge must remain.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="discard"/>
                    <xs:enumeration value="retain"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute ref="fox:border-radius"/>
        <xs:attribute ref="fox:border-before-start-radius"/>
        <xs:attribute ref="fox:border-before-end-radius"/>
        <xs:attribute ref="fox:border-after-start-radius"/>
        <xs:attribute ref="fox:border-after-end-radius"/>
        <xs:attribute ref="fox:background-image-width"/>
        <xs:attribute ref="fox:background-image-height"/>
    </xs:attributeGroup>

    <xs:attributeGroup name="border-precedence-properties">
        <xs:annotation><xs:documentation>Border conflict priorities for the XSL-FO collapse-with-precedence table border model. See border-collapse for FOP compatibility.</xs:documentation></xs:annotation>
        <xs:attribute name="border-after-precedence">
            <xs:annotation>
                <xs:documentation compat:feature="border-after-precedence"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Priority of the logical after border in the table border conflict algorithm.

                    FOP 2.12: Unsupported. Requires collapse-with-precedence.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-before-precedence">
            <xs:annotation>
                <xs:documentation compat:feature="border-before-precedence"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Priority of the logical before border in the table border conflict algorithm.

                    FOP 2.12: Unsupported. Requires collapse-with-precedence.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-end-precedence">
            <xs:annotation>
                <xs:documentation compat:feature="border-end-precedence"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Priority of the logical end border in the table border conflict algorithm.

                    FOP 2.12: Unsupported. Requires collapse-with-precedence.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="border-start-precedence">
            <xs:annotation>
                <xs:documentation compat:feature="border-start-precedence"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Priority of the logical start border in the table border conflict algorithm.

                    FOP 2.12: Unsupported. Requires collapse-with-precedence.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="box-size-properties">
        <xs:annotation><xs:documentation>Physical width and height, and logical inline/block progression dimensions. For horizontal writing, inline is width and block is height.</xs:documentation></xs:annotation>
        <xs:attribute name="height">
            <xs:annotation><xs:documentation>Physical area height, e.g. "25mm". Use auto to let the formatter calculate it.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="min-height">
            <xs:annotation><xs:documentation>Lower limit on area height, e.g. "16pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="max-height">
            <xs:annotation><xs:documentation>Upper limit on area height, e.g. "200pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="width">
            <xs:annotation><xs:documentation>Physical area width, e.g. "64mm" or "100%". Use auto to let the formatter calculate it.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="min-width">
            <xs:annotation><xs:documentation>Lower limit on area width, e.g. "30mm".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="max-width">
            <xs:annotation><xs:documentation>Upper limit on area width, e.g. "90mm".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="inline-progression-dimension">
            <xs:annotation><xs:documentation>Size along the writing direction (width in horizontal text), e.g. "100pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="inline-progression-dimension.minimum">
            <xs:annotation><xs:documentation>Smallest allowed inline progression dimension, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="inline-progression-dimension.optimum">
            <xs:annotation><xs:documentation>Preferred inline progression dimension, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="inline-progression-dimension.maximum">
            <xs:annotation><xs:documentation>Largest allowed inline progression dimension, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="block-progression-dimension">
            <xs:annotation><xs:documentation>Size perpendicular to the writing direction (height in horizontal text), e.g. "36pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="block-progression-dimension.minimum">
            <xs:annotation><xs:documentation>Smallest allowed block progression dimension, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="block-progression-dimension.optimum">
            <xs:annotation><xs:documentation>Preferred block progression dimension, e.g. "4pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="block-progression-dimension.maximum">
            <xs:annotation><xs:documentation>Largest allowed block progression dimension, e.g. "8pt".</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="area-properties">
        <xs:annotation><xs:documentation>Clipping, overflow, display alignment, and coordinate/direction properties for areas.</xs:documentation></xs:annotation>
        <xs:attribute name="clip">
            <xs:annotation>
                <xs:documentation compat:feature="clip"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source runtime-probe">
                    Clip an area to a specified rectangle, e.g. rect(0pt, 80pt, 40pt, 0pt).

                    FOP 2.12: Unsupported. A CSS-style clipping rectangle is not implemented.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="overflow">
            <xs:annotation><xs:documentation>How to handle content beyond the viewport: visible, hidden, scroll, auto, or error-if-overflow. A PDF is not a scrollable viewport.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="visible"/>
                    <xs:enumeration value="hidden"/>
                    <xs:enumeration value="scroll"/>
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="error-if-overflow"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="display-align">
            <xs:annotation>
                <xs:documentation compat:feature="display-align"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Align content inside the available area in the block direction: before, center or after, e.g. center in a tall table cell.

                    FOP 2.12: Partial. An explicitly sized fo:inline-container ignores before/after alignment.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="before"/>
                    <xs:enumeration value="center"/>
                    <xs:enumeration value="after"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="reference-orientation">
            <xs:annotation><xs:documentation>Rotate reference-area coordinates counterclockwise. Use a signed multiple of 90 without a unit, e.g. "90".</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="0"/>
                    <xs:enumeration value="90"/>
                    <xs:enumeration value="180"/>
                    <xs:enumeration value="270"/>
                    <xs:enumeration value="-90"/>
                    <xs:enumeration value="-180"/>
                    <xs:enumeration value="-270"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="writing-mode">
            <xs:annotation>
                <xs:documentation>Sets line progression: lr-tb for left-to-right text, rl-tb for right-to-left text, and tb-rl or tb-lr for top-to-bottom lines. The glyph-orientation properties are separate.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="lr-tb"/>
                    <xs:enumeration value="rl-tb"/>
                    <xs:enumeration value="tb-rl"/>
                    <xs:enumeration value="tb-lr"/>
                    <xs:enumeration value="lr"/>
                    <xs:enumeration value="rl"/>
                    <xs:enumeration value="tb"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:attributeGroup name="font-properties">
        <xs:annotation><xs:documentation>Select a font and control its presentation. FOP matches font-family, font-style and font-weight to a registered font triplet.</xs:documentation></xs:annotation>
        <xs:attribute name="font">
            <xs:annotation>
                <xs:documentation compat:feature="font shorthand"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Combines font properties, e.g. "italic bold 12pt serif".

                    FOP 2.12: Partial. System-font keywords such as caption are ignored. Set font-family and font-size explicitly instead.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="font-selection-strategy">
            <xs:annotation><xs:documentation>How to select from the font-family list, e.g. character-by-character for per-character fallback. Check the chosen fonts can render all characters.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="auto"/>
                    <xs:enumeration value="character-by-character"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="font-family">
            <xs:annotation><xs:documentation>Comma-separated font family preferences, e.g. "Example Sans, Helvetica, sans-serif". Register custom fonts in fop.xconf.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="font-size">
            <xs:annotation><xs:documentation>Font size, e.g. "12pt" or "90%". Relative values are based on the inherited size.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="font-size-adjust">
            <xs:annotation>
                <xs:documentation compat:feature="font-size-adjust"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Target aspect value for preserving apparent lowercase x-height across fallback fonts.

                    FOP 2.12: Unsupported.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="font-stretch">
            <xs:annotation>
                <xs:documentation compat:feature="font-stretch"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Select a condensed or expanded face of the family, e.g. condensed.

                    FOP 2.12: Unsupported. Select a registered condensed or expanded face by family name.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="normal"/>
                    <xs:enumeration value="wider"/>
                    <xs:enumeration value="narrower"/>
                    <xs:enumeration value="ultra-condensed"/>
                    <xs:enumeration value="extra-condensed"/>
                    <xs:enumeration value="condensed"/>
                    <xs:enumeration value="semi-condensed"/>
                    <xs:enumeration value="semi-expanded"/>
                    <xs:enumeration value="expanded"/>
                    <xs:enumeration value="extra-expanded"/>
                    <xs:enumeration value="ultra-expanded"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="font-style">
            <xs:annotation><xs:documentation>Choose normal, italic, oblique or backslant. The requested face must be registered or supported by a fallback.</xs:documentation></xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="normal"/>
                    <xs:enumeration value="italic"/>
                    <xs:enumeration value="oblique"/>
                    <xs:enumeration value="backslant"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="font-variant">
            <xs:annotation>
                <xs:documentation compat:feature="font-variant"
                                  compat:status="unsupported" compat:fop="2.12"
                                  compat:evidence="source area-tree-test">
                    Choose normal letters or small caps (small-caps).

                    FOP 2.12: Unsupported. Use an appropriate font face for small caps.
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:token">
                    <xs:enumeration value="normal"/>
                    <xs:enumeration value="small-caps"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="font-weight">
            <xs:annotation>
                <xs:documentation compat:feature="font-weight=&quot;bolder&quot; / &quot;lighter&quot;"
                                  compat:status="partial" compat:fop="2.12"
                                  compat:evidence="source pdf-test">
                    Weight such as normal (400), bold (700), or numeric 100 to 900. Use a registered face instead of relying on synthesis.

                    FOP 2.12: Partial. Relative weights step through numeric values, not available faces. Select an explicit weight to choose a particular face.
                </xs:documentation>
