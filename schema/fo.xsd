                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-after.minimum">
            <xs:annotation><xs:documentation>Smallest allowed space after, e.g. "1pt".</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="space-after.optimum">
            <xs:annotation><xs:documentation>Preferred space after, e.g. "4pt".</xs:documentation></xs:annotation>
