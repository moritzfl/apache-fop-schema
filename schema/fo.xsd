                <xs:restriction base="xs:token">
                    <xs:enumeration value="ignore"/>
                    <xs:enumeration value="preserve"/>
                    <xs:enumeration value="treat-as-space"/>
                    <xs:enumeration value="treat-as-zero-width-space"/>
