<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://xmlgraphics.apache.org/fop/config"
           elementFormDefault="qualified">
    <xs:annotation><xs:documentation>Namespaced FOP configuration using this project's configuration namespace. Both default-namespace and prefixed forms validate. For direct use with FOP 2.12, declare the default namespace and leave element names unprefixed; FOP looks up literal names and ignores prefixed settings. Normalize prefixed files before rendering.</xs:documentation></xs:annotation>
    <xs:include schemaLocation="fop-config-no-namespace.xsd"/>
</xs:schema>
