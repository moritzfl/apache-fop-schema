<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:compat="urn:apache-fop-schema:compatibility"
           xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"
           targetNamespace="http://xmlgraphics.apache.org/fop/extensions"
           elementFormDefault="qualified">
    <xs:annotation>
        <xs:documentation source="https://xmlgraphics.apache.org/fop/2.12/extensions.html">General FOP 2.12 extensions. Extension properties are namespace-qualified; the local attributes on extension elements below are not.</xs:documentation>
    </xs:annotation>
    <xs:annotation>
        <xs:documentation compat:feature="fox:document-info / fox:document-info-entry"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Not registered in ExtensionElementMapping. Use XMP, FOUserAgent, or pdf:info for custom PDF Info.
        </xs:documentation>
        <xs:documentation compat:feature="fox:accessibility"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Not registered as an element. Use &lt;accessibility&gt; in fop.xconf and fox:alt-text on graphics.
        </xs:documentation>
        <xs:documentation compat:feature="fox:form-field"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Not registered as an element. FO markup does not create PDF form fields with this name.
        </xs:documentation>
        <xs:documentation compat:feature="fox:watermark"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Not registered as an element. A page master's background image is one supported way to add a repeated background.
        </xs:documentation>
        <xs:documentation compat:feature="fox:pdf-security"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Not registered as an element. Use PDF renderer &lt;encryption-params&gt; instead.
        </xs:documentation>
        <xs:documentation compat:feature="fox:outline / fox:label"
                          compat:status="unsupported" compat:fop="2.12"
                          compat:evidence="source runtime-probe">
            FOP 2.12: Unsupported. Registered as unknown legacy objects. Use the standard fo:bookmark-tree.
        </xs:documentation>
        <xs:documentation compat:feature="Other renderer extensions, such as afp:, pcl:, and ps:"
                          compat:status="not-modeled" compat:fop="2.12"
                          compat:evidence="schema-scope" source="https://xmlgraphics.apache.org/fop/2.12/extensionsreference.html">
            FOP 2.12: Not modeled. This project does not define those renderer extensions; see the FOP extensions reference for them.
        </xs:documentation>
    </xs:annotation>
    <xs:simpleType name="BooleanKeyword">
        <xs:annotation><xs:documentation>FO boolean property keywords, not XML Schema's numeric booleans.</xs:documentation></xs:annotation>
        <xs:restriction base="xs:token">
            <xs:enumeration value="true"/>
            <xs:enumeration value="false"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:attribute name="alt-text" type="xs:string">
        <xs:annotation><xs:documentation source="https://xmlgraphics.apache.org/fop/2.12/accessibility.html">Text alternative for a graphic, inline foreign object, or basic link in tagged PDF. Describe the information or link purpose, e.g. "Sales rose from 20 to 35". Enable accessibility in the FOP configuration. FOP 2.12 also writes this to the internal link annotation's Contents.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="header" type="fox:BooleanKeyword">
        <xs:annotation><xs:documentation source="https://xmlgraphics.apache.org/fop/2.12/accessibility.html">On fo:table-column, true marks cells in that column as row headers in tagged PDF. Cells in fo:table-header are already column headers.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="abbreviation" type="xs:string">
        <xs:annotation><xs:documentation>Expansion for an fo:inline in tagged PDF, e.g. fox:abbreviation="World Wide Web" for "WWW". This is PDF structure metadata, not replacement text for layout.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="auto-toggle">
        <xs:annotation><xs:documentation>On fo:multi-switch, select-first-fitting chooses the first case that fits the available space. This is a layout choice, not an interactive PDF toggle.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:token">
            <xs:enumeration value="select-first-fitting"/>
        </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="disable-column-balancing" type="fox:BooleanKeyword">
        <xs:annotation><xs:documentation>On fo:flow, true disables column balancing before spans. It does not change the number of columns.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="block-progression-unit" type="xs:string">
        <xs:annotation>
            <xs:documentation compat:feature="fox:block-progression-unit"
                              compat:status="unsupported" compat:fop="2.12"
                              compat:evidence="source runtime-probe">
                Length property intended for block-progression grid alignment.

                FOP 2.12: Unsupported. Listed by ExtensionElementMapping but no property maker in FOPropertyMapping; do not rely on it for grid layout.
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>
    <xs:attribute name="widow-content-limit" type="xs:string">
        <xs:annotation><xs:documentation>Minimum length of trailing content kept together across a break in fo:table or fo:list-block, e.g. "3 * 1.2em".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="orphan-content-limit" type="xs:string">
        <xs:annotation><xs:documentation>Minimum length of leading content kept together across a break in fo:table or fo:list-block, e.g. "3 * 1.2em".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="scale" type="xs:string">
        <xs:annotation><xs:documentation>One page scale factor or separate horizontal and vertical factors, e.g. "0.8 1.2". The prepress extension is implemented for PDF and Java2D.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="bleed" type="xs:string">
        <xs:annotation><xs:documentation>Expands the trim box to the bleed box in PDF or Java2D. Use one to four nonnegative lengths in CSS padding order, e.g. "3mm" or "3mm 5mm".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="crop-offset" type="xs:string">
        <xs:annotation><xs:documentation>Expands the trim box to the media box in PDF or Java2D. Use one to four nonnegative lengths in CSS padding order. Defaults to fox:bleed.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="crop-box">
        <xs:annotation><xs:documentation>Choose which box is used for cropping in PDF or Java2D: trim-box, bleed-box, or media-box (default).</xs:documentation></xs:annotation>
        <xs:simpleType>
            <xs:restriction base="xs:token">
                <xs:enumeration value="trim-box"/>
                <xs:enumeration value="bleed-box"/>
                <xs:enumeration value="media-box"/>
            </xs:restriction>
        </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="transform" type="xs:string">
        <xs:annotation><xs:documentation>SVG-style transformation on an absolutely or fixed-positioned fo:block-container. FOP uses millipoints: translate(10000,0) moves content 10pt right. Supported for PDF, PostScript and Java2D.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="border-radius" type="xs:string">
        <xs:annotation><xs:documentation>Rounded corners on block areas. Set one radius for circular corners or two for elliptical ones (inline then block direction), e.g. "4pt 8pt". Tables require border-collapse="separate".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="border-before-start-radius" type="xs:string">
        <xs:annotation><xs:documentation>Radius at the intersection of the before and start borders. Use one or two lengths, e.g. "4pt".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="border-before-end-radius" type="xs:string">
        <xs:annotation><xs:documentation>Radius at the intersection of the before and end borders. Use one or two lengths, e.g. "4pt".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="border-after-start-radius" type="xs:string">
        <xs:annotation><xs:documentation>Radius at the intersection of the after and start borders. Use one or two lengths, e.g. "4pt".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="border-after-end-radius" type="xs:string">
        <xs:annotation><xs:documentation>Radius at the intersection of the after and end borders. Use one or two lengths, e.g. "4pt".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background-image-width" type="xs:string">
        <xs:annotation><xs:documentation>Rescale a background image to the specified width, e.g. "24pt".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="background-image-height" type="xs:string">
        <xs:annotation><xs:documentation>Rescale a background image to the specified height, e.g. "24pt".</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="layer" type="xs:string">
        <xs:annotation><xs:documentation>Associate content with a PDF optional-content layer. Value is the ID of a pdf:layer declaration.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rule-style">
        <xs:annotation><xs:documentation>FOP-specific style for fo:leader with leader-pattern="rule"; use square for a line of square marks, or none (default) to use the standard rule-style property.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:token"><xs:enumeration value="none"/><xs:enumeration value="square"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="number-conversion-features" type="xs:string">
        <xs:annotation><xs:documentation>Additional number-conversion features for certain numbering formats on fo:page-sequence. Values depend on the numbering format and language.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:element name="destination">
        <xs:annotation><xs:documentation>Creates a named PDF destination from an FO element's ID. Place it under fo:root or in the content, e.g. &lt;fox:destination internal-destination="chapter-one"/&gt;.</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:attribute name="internal-destination" type="xs:NCName" use="required">
                <xs:annotation><xs:documentation>The ID of the target FO, e.g. "chapter-one". Do not qualify this attribute with fox:.</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="external-document">
        <xs:annotation>
            <xs:documentation compat:feature="fox:external-document with PDF input"
                              compat:status="plug-in-required" compat:fop="2.12"
                              compat:evidence="source pdf-test upstream-docs" source="https://xmlgraphics.apache.org/fop/fop-pdf-images.html">
                Add an image as a whole page, as a peer of fo:page-sequence. Single-page images are the documented baseline. This cannot concatenate FO documents.

                FOP 2.12: Plug-in required. The core suite verifies a single SVG page; PDF input requires the FOP PDF Images plug-in.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="src" type="xs:string" use="required">
                <xs:annotation><xs:documentation>Image URI, e.g. url('cover.svg'). Resolve relative paths against the FOP base URI.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="id" type="xs:ID">
                <xs:annotation><xs:documentation>Unique ID that can identify this page sequence as a link target.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="width" type="xs:string">
                <xs:annotation><xs:documentation>Width of the image viewport and thus of the output page; defaults to auto.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="height" type="xs:string">
                <xs:annotation><xs:documentation>Height of the image viewport and thus of the output page; defaults to auto.</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="content-width" type="xs:string">
                <xs:annotation><xs:documentation>Width of the image within the viewport, e.g. "100%" or "120pt".</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="content-height" type="xs:string">
                <xs:annotation><xs:documentation>Height of the image within the viewport, e.g. "100%" or "80pt".</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="scaling">
                <xs:annotation><xs:documentation>Choose uniform scaling to preserve aspect ratio or non-uniform scaling to allow distortion.</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="uniform"/>
                    <xs:enumeration value="non-uniform"/>
                    <xs:enumeration value="inherit"/>
                </xs:restriction></xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
