<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format"
         xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.w3.org/1999/XSL/Format ../../../schema/fo.xsd">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="trim" page-width="200pt" page-height="300pt" margin="12pt"
                               fox:bleed="4pt" fox:crop-offset="8pt" fox:crop-box="trim-box">
            <fo:region-body/>
        </fo:simple-page-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="trim">
        <fo:flow flow-name="xsl-region-body">
            <fo:table-and-caption>
                <fo:table-caption><fo:block color="cmyk(100%,0%,0%,0%)">Sales figures</fo:block></fo:table-caption>
                <fo:table table-layout="fixed" width="160pt">
                    <fo:table-column column-width="80pt"/>
                    <fo:table-column column-width="80pt"/>
                    <fo:table-body>
                        <fo:table-row>
                            <fo:table-cell><fo:block>November</fo:block></fo:table-cell>
                            <fo:table-cell><fo:block>35 units</fo:block></fo:table-cell>
                        </fo:table-row>
                    </fo:table-body>
                </fo:table>
            </fo:table-and-caption>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
