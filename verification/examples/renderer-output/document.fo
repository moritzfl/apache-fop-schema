<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.w3.org/1999/XSL/Format ../../../schema/fo.xsd">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="sample" page-width="2in" page-height="1in" margin="6pt">
            <fo:region-body/>
        </fo:simple-page-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="sample" force-page-count="no-force">
        <fo:flow flow-name="xsl-region-body">
            <fo:block-container width="30pt" height="25pt" background-color="#ef1122">
                <fo:block/>
            </fo:block-container>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
