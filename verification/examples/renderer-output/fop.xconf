<?xml version="1.0" encoding="UTF-8"?>
<fop version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="../../../schema/fop-config-no-namespace.xsd">
    <target-resolution>144</target-resolution>
    <renderers>
        <renderer mime="application/x-afp">
            <renderer-resolution>300</renderer-resolution>
        </renderer>
        <renderer mime="application/postscript">
            <language-level>2</language-level>
        </renderer>
        <renderer mime="image/png">
            <transparent-page-background>true</transparent-page-background>
        </renderer>
    </renderers>
</fop>
